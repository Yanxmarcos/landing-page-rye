---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const service = services.find(s => s.slug === 'posicionamiento-organico');

if (!service) {
  throw new Error("No se encontraron los datos para el servicio 'posicionamiento-organico'.");
}
---

<BaseLayout
  title={`${service.title} | Agencia de Marketing Digital`}
  description={service.description}
>
  <article class="service-master-layout" style="--accent-hex: #10B981; --accent-rgb: 16, 185, 129;">
    
    <!-- Orbes decorativos de fondo para dar profundidad a Light/Dark mode -->
    <div class="ambient-orbs">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
    </div>

    <header class="master-hero scroll-animate">
      <div class="container hero-grid">
        <div class="hero-content">
          <div class="badge-growth">
            <span class="pulse-dot"></span>
            {service.tag}
          </div>
          <h1 class="hero-title">
            Deja de buscar clientes. <br/>
            <span class="text-highlight">Haz que te encuentren.</span>
          </h1>
          <p class="hero-desc">{service.description}</p>
          <div class="hero-actions">
            <a href="/#contacto" class="btn-primary shadow-btn">Solicitar Auditoría SEO</a>
            <a href="#metodologia" class="btn-outline">Ver metodología</a>
          </div>
          <p class="trust-note">Tráfico orgánico = Clientes de alto valor</p>
        </div>

        <div class="hero-visual">
          <div class="search-mockup-container glass-panel">
            <div class="search-bar">
              <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <div class="typing-text">mejores servicios en mi ciudad...</div>
            </div>
            
            <div class="search-results">
              <div class="result-card top-result glass-card">
                <span class="sponsored-tag">Orgánico #1</span>
                <div class="result-link">www.tuempresa.com</div>
                <div class="result-title">Tu Negocio | Líderes en el Sector</div>
                <div class="result-desc">La mejor solución para tus necesidades. Descubre por qué cientos de clientes nos eligen cada día.</div>
              </div>
              
              <div class="result-card competitor opacity-50 glass-card">
                <div class="result-link">www.competencia.com</div>
                <div class="result-title">Empresa Competidora</div>
                <div class="result-desc">Servicios genéricos del sector.</div>
              </div>
            </div>
            <div class="ambient-glow"></div>
          </div>
        </div>
      </div>
    </header>

    <section class="master-reality scroll-animate delay-1">
      <div class="container">
        <div class="glass-panel stats-box">
          <div class="stats-big">
            <span class="number">90%</span>
            <span class="label">de los usuarios no pasa a la página 2</span>
          </div>
          <div class="stats-text">
            <h2>Si no estás en Google, no existes.</h2>
            <p>{service.detailedDescription}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="metodologia" class="master-details scroll-animate delay-2">
      <div class="container layout-grid">
        
        <main class="details-main">
          
          <h3 class="features-title">Nuestra Metodología de Posicionamiento</h3>
          <div class="features-list process-timeline">
            {service.features.map((feature, idx) => (
              <div class="feature-item glass-card timeline-step">
                <div class="step-number-glass">0{idx + 1}</div>
                <div class="feature-text">
                  <h4>{feature.title}</h4>
                  <p>{feature.description}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="audience-wrapper mt-5">
            <h3 class="features-title">¿A quién ayudamos a dominar su nicho?</h3>
            <div class="audience-grid">
              {service.targetAudience.map(audience => (
                <div class="glass-card audience-box">
                  <div class="icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent-hex)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                  </div>
                  <h4>{audience.role}</h4>
                  <p>{audience.focus}</p>
                </div>
              ))}
            </div>
          </div>

        </main>

        <aside class="details-sidebar">
          <div class="glass-panel sticky-card">
            <div class="pricing-header text-center">
              <h3>Campaña SEO</h3>
              <p>Construye un activo digital a largo plazo</p>
            </div>
            
            <div class="investment-row">
              <div class="inv-col">
                <span class="label">Inversión mensual</span>
                <span class="price">{service.priceFrom}</span>
              </div>
              <div class="inv-col timeline">
                <span class="label">Resultados</span>
                <span class="time">{service.delivery}</span>
              </div>
            </div>

            <div class="benefits-checklist">
              <h4>Tu campaña incluye:</h4>
              <ul>
                {service.benefits.map(benefit => (
                  <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-hex)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a href="/#contacto" class="btn-primary w-full shadow-btn">Analizar a mi competencia</a>
            <div class="secure-note">
              <p>Trabajamos con exclusividad de nicho por ciudad.</p>
            </div>
          </div>
        </aside>

      </div>
    </section>

  </article>
</BaseLayout>

<script>
  // Script para lanzar animaciones SOLO cuando el elemento entra en pantalla
  function initAnimations() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.scroll-animate').forEach(el => {
      observer.observe(el);
    });
  }

  initAnimations();
  document.addEventListener('astro:after-swap', initAnimations); // Soporte ViewTransitions
</script>

<style>
  /* =========================================================================
     SISTEMA DINÁMICO DE TEMAS (LIGHT/DARK)
  ========================================================================= */
  
  .service-master-layout {
    /* TEMA OSCURO POR DEFECTO */
    --bg-page: #0B1120;
    --bg-surface: #111827;
    --bg-glass: rgba(17, 24, 39, 0.65);
    --text-primary: #F8FAFC;
    --text-secondary: #94A3B8;
    --border-color: rgba(255, 255, 255, 0.1);
    --shadow-glass: 0 8px 32px rgba(0, 0, 0, 0.4);
    --border-glass: 1px solid rgba(255, 255, 255, 0.05);
    --hero-grid-color: rgba(255, 255, 255, 0.05);
    --link-color: #60A5FA;
    --btn-hover-bg: rgba(var(--accent-rgb), 0.15);
    --card-shadow-hover: 0 12px 30px rgba(var(--accent-rgb), 0.25);
    
    background-color: var(--bg-page);
    color: var(--text-primary);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  /* TEMA OSCURO (Por clase y por sistema operativo) */
  :global([data-theme="light"]) .service-master-layout {
    --bg-page: #F8FAFC; 
    --bg-surface: #FFFFFF; 
    --bg-glass: rgba(255, 255, 255, 0.7);
    --text-primary: #0F172A;
    --text-secondary: #475569;
    --border-color: rgba(15, 23, 42, 0.1);
    --shadow-glass: 0 10px 30px -5px rgba(0, 0, 0, 0.05);
    --border-glass: 1px solid rgba(255, 255, 255, 0.6);
    --hero-grid-color: rgba(15, 23, 42, 0.05);
    --link-color: #1E40AF;
    --btn-hover-bg: rgba(var(--accent-rgb), 0.05);
    --card-shadow-hover: 0 12px 24px rgba(var(--accent-rgb), 0.15);
  }

  /* =========================================================================
     ORBES AMBIENTALES DE FONDO
  ========================================================================= */
  .ambient-orbs { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.4; transition: opacity 0.5s ease; }
  .orb-1 { top: -10%; left: -10%; width: 50vw; height: 50vw; background: var(--accent-hex); max-width: 600px; max-height: 600px; }
  .orb-2 { bottom: 10%; right: -5%; width: 40vw; height: 40vw; background: #3B82F6; opacity: 0.15; max-width: 500px; max-height: 500px; }

  /* En modo oscuro, los orbes son más sutiles */
  .orb { opacity: 0.15; }
  :global([data-theme="light"]) .orb { opacity: 0.4; }

  /* =========================================================================
     COMPONENTES UI Y ANIMACIONES SCROLL
  ========================================================================= */
  .glass-panel { 
    background: var(--bg-glass); 
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); 
    border: var(--border-glass); box-shadow: var(--shadow-glass); 
    border-radius: 24px; transition: background 0.3s ease, border 0.3s ease;
  }
  .glass-card { 
    background: var(--bg-surface); border: 1px solid var(--border-color); 
    border-radius: 16px; transition: all 0.3s ease; 
  }
  .glass-card:hover { 
    border-color: var(--accent-hex); transform: translateY(-4px); box-shadow: var(--card-shadow-hover); 
  }

  .btn-primary { 
    display: inline-flex; justify-content: center; align-items: center; 
    background: var(--accent-hex); color: #fff; 
    padding: 1rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 1.125rem;
    text-decoration: none; transition: all 0.3s ease; 
  }
  .shadow-btn { box-shadow: 0 10px 25px rgba(var(--accent-rgb), 0.3); }
  .btn-primary:hover { filter: brightness(1.1); transform: translateY(-2px); }
  
  .btn-outline { 
    display: inline-flex; justify-content: center; align-items: center; 
    background: transparent; color: var(--text-primary); 
    padding: 1rem 1.5rem; border-radius: 8px; font-weight: 600; 
    text-decoration: none; transition: all 0.3s ease; border: 1px solid var(--border-color); 
  }
  .btn-outline:hover { border-color: var(--accent-hex); color: var(--accent-hex); background: var(--btn-hover-bg); }
  .w-full { width: 100%; }
  .text-center { text-align: center; }
  .mt-5 { margin-top: 3rem; }

  /* Animación Controlada por Scroll (Observer) */
  .scroll-animate { opacity: 0; transform: translateY(30px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .scroll-animate.is-visible { opacity: 1; transform: translateY(0); }
  .delay-1 { transition-delay: 0.2s; }
  .delay-2 { transition-delay: 0.4s; }

  /* =========================================================================
     1. HERO SECTION
  ========================================================================= */
  .master-hero { padding-top: calc(var(--section-py, 4rem) + 4rem); padding-bottom: 4rem; position: relative; z-index: 1; }
  
  .master-hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(var(--hero-grid-color) 1px, transparent 1px), linear-gradient(90deg, var(--hero-grid-color) 1px, transparent 1px);
    background-size: 30px 30px; z-index: -1; pointer-events: none;
    mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
  }

  .hero-grid { display: grid; gap: 4rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 992px) { .hero-grid { grid-template-columns: 1fr 1fr; } }

  .badge-growth { 
    display: inline-flex; align-items: center; gap: 0.5rem; 
    background: rgba(var(--accent-rgb), 0.15); color: var(--accent-hex); 
    padding: 0.5rem 1rem; border-radius: 100px; 
    font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; 
    margin-bottom: 1.5rem; border: 1px solid rgba(var(--accent-rgb), 0.3); 
  }
  .pulse-dot { width: 8px; height: 8px; background: var(--accent-hex); border-radius: 50%; box-shadow: 0 0 8px var(--accent-hex); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.4); } 70% { box-shadow: 0 0 0 10px rgba(var(--accent-rgb), 0); } 100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0); } }

  .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: 1.5rem; font-weight: 800; color: var(--text-primary); }
  .text-highlight { color: var(--accent-hex); }
  .hero-desc { font-size: 1.25rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 2.5rem; max-width: 90%; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .trust-note { font-size: 0.875rem; color: var(--text-secondary); margin-top: 1.5rem; font-weight: 500; }

  /* MOCKUP DE BÚSQUEDA */
  .search-mockup-container { padding: 2rem; overflow: visible; transform: rotate(2deg) perspective(1000px); transition: transform 0.4s ease, box-shadow 0.4s ease; }
  .search-mockup-container:hover { transform: rotate(0deg) perspective(1000px); box-shadow: var(--card-shadow-hover); }
  
  .search-bar { display: flex; align-items: center; gap: 1rem; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 100px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); position: relative; z-index: 2; transition: border-color 0.3s ease, background 0.3s ease; }
  .search-icon { color: var(--text-secondary); transition: color 0.3s ease; }
  .typing-text { color: var(--text-primary); font-family: monospace; font-size: 1rem; white-space: nowrap; overflow: hidden; border-right: 2px solid var(--accent-hex); width: 0; animation: typing 6s steps(30, end) infinite, blink-cursor .75s step-end infinite; }

  /* Bucle realista: Escribe, pausa, borra, pausa */
  @keyframes typing { 0%, 10% { width: 0 } 40%, 60% { width: 100% } 90%, 100% { width: 0 } }
  @keyframes blink-cursor { from, to { border-color: transparent } 50% { border-color: var(--accent-hex); } }

  .search-results { display: flex; flex-direction: column; gap: 1rem; position: relative; z-index: 2; }
  .result-card { padding: 1.25rem; border-left: 4px solid transparent; }
  .top-result { border-color: var(--accent-hex); border-left-color: var(--accent-hex); }
  
  .sponsored-tag { font-size: 0.7rem; font-weight: 700; color: var(--accent-hex); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem; }
  .result-link { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem; font-family: monospace; }
  .result-title { font-size: 1.125rem; color: var(--link-color); font-weight: 600; margin-bottom: 0.25rem; transition: color 0.3s ease; }
  .result-desc { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; }
  .opacity-50 { opacity: 0.6; filter: grayscale(80%); }

  .ambient-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; height: 80%; background: radial-gradient(circle, rgba(var(--accent-rgb), 0.15) 0%, rgba(var(--accent-rgb), 0) 70%); z-index: 0; filter: blur(40px); pointer-events: none; }

  /* =========================================================================
     2. REALITY CHECK
  ========================================================================= */
  .master-reality { padding: 2rem 0 4rem 0; position: relative; z-index: 2; }
  .stats-box { padding: 3rem; display: flex; flex-direction: column; gap: 2rem; align-items: center; text-align: center; }
  @media (min-width: 768px) { .stats-box { flex-direction: row; text-align: left; justify-content: space-between; padding: 4rem; } }

  .stats-big { display: flex; flex-direction: column; flex-shrink: 0; }
  .number { font-size: 5rem; font-weight: 900; color: var(--accent-hex); line-height: 1; letter-spacing: -0.05em; }
  .label { font-size: 1.125rem; font-weight: 600; color: var(--text-primary); max-width: 200px; text-transform: uppercase; margin-top: 0.5rem; }

  .stats-text h2 { font-size: 2rem; color: var(--text-primary); margin-bottom: 1rem; }
  .stats-text p { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.7; }

  /* =========================================================================
     3. DETAILS & SIDEBAR
  ========================================================================= */
  .master-details { padding: 0 0 4rem 0; position: relative; z-index: 2; }
  .layout-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 992px) { .layout-grid { grid-template-columns: 1fr 380px; gap: 4rem; align-items: start; } }

  .features-title { font-size: 1.75rem; color: var(--text-primary); margin-bottom: 2rem; font-weight: 700; }
  
  .process-timeline { display: flex; flex-direction: column; gap: 1.5rem; position: relative; }
  .process-timeline::before { content: ''; position: absolute; left: 32px; top: 0; bottom: 0; width: 2px; background: var(--border-color); z-index: 0; }
  
  .timeline-step { display: flex; gap: 1.5rem; padding: 1.5rem; align-items: flex-start; position: relative; z-index: 1; border-left: none; }
  .step-number-glass { width: 40px; height: 40px; background: var(--bg-surface); border: 2px solid var(--accent-hex); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1rem; color: var(--accent-hex); flex-shrink: 0; box-shadow: 0 4px 10px rgba(var(--accent-rgb), 0.1); position: relative; z-index: 2; margin-top: 0.25rem; transition: background 0.3s ease; }
  .feature-text h4 { font-size: 1.25rem; color: var(--text-primary); margin-bottom: 0.5rem; }
  .feature-text p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0; }

  .audience-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
  .audience-box { padding: 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .icon-wrapper { width: 56px; height: 56px; background: rgba(var(--accent-rgb), 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; font-size: 1.5rem;}
  .audience-box h4 { font-size: 1.125rem; color: var(--text-primary); margin-bottom: 0.5rem; }
  .audience-box p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.5; margin: 0; }

  /* Sticky Sidebar */
  .details-sidebar { position: sticky; top: 100px; }
  .sticky-card { padding: 2.5rem; border: 2px solid rgba(var(--accent-rgb), 0.2); }
  
  .pricing-header { border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; margin-bottom: 1.5rem; transition: border-color 0.3s ease;}
  .pricing-header h3 { font-size: 1.5rem; color: var(--text-primary); margin-bottom: 0.25rem; font-weight: 700; }
  .pricing-header p { color: var(--text-secondary); font-size: 0.9rem; }

  .investment-row { display: flex; background: var(--bg-page); border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 2rem; overflow: hidden; transition: background 0.3s ease, border-color 0.3s ease;}
  .inv-col { flex: 1; padding: 1.25rem 1rem; text-align: center; }
  .inv-col.timeline { background: rgba(var(--accent-rgb), 0.1); }
  
  .inv-col .label { display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); margin-bottom: 0.5rem; }
  .inv-col .price { display: block; font-size: 1.5rem; font-weight: 800; color: var(--text-primary); }
  .inv-col.timeline .label { color: var(--accent-hex); }
  .inv-col.timeline .time { display: block; font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-top: 0.5rem; }

  .benefits-checklist { margin-bottom: 2rem; }
  .benefits-checklist h4 { font-size: 1rem; color: var(--text-primary); margin-bottom: 1rem; font-weight: 600; }
  .benefits-checklist ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .benefits-checklist li { display: flex; gap: 0.75rem; color: var(--text-secondary); font-size: 0.95rem; align-items: flex-start; line-height: 1.4; }
  .benefits-checklist li svg { flex-shrink: 0; }

  .secure-note { text-align: center; font-size: 0.8rem; color: var(--text-secondary); margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color); transition: border-color 0.3s ease; }
</style>