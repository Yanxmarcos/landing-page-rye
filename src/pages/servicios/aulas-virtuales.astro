  const lottieContainers = {
    'video':    '/animations/edu-video-player.json',
    'students': '/animations/edu-students.json',
    'revenue':  '/animations/edu-revenue.json',
    'cert':     '/animations/edu-certificate.json',
  };

  Object.entries(lottieContainers).forEach(([key, path]) => {
    const el = document.querySelector(`.mini-ui--${key}`);
    if (el) {
      lottie.loadAnimation({
        container: el,
        path,
        renderer: 'svg',
        loop: true,
        autoplay: true,
      });
    }
  });
  */


  // ── 5. PLACEHOLDER: Three.js ──
  // Para el hero visual, descomenta y adapta:
  /*
