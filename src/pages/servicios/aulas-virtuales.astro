<!-- ═════════════════════════════════════════════════════
     SCRIPT — IntersectionObserver para animaciones
     Funciona sin ninguna dependencia externa.
     Las animaciones se disparan al hacer scroll.
════════════════════════════════════════════════════ -->
<script>
  // ── 1. Animaciones de entrada (fade-up / fade-left) ──
  // Cada elemento con [data-animate] entra suavemente
  // cuando entra en el viewport.
  const animEls = document.querySelectorAll('[data-animate]');

  const entryObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          // Stagger: cada elemento espera un poco más que el anterior
          const delay = (i % 5) * 90; // máx ~360ms de escalonado
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, delay);
          entryObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  animEls.forEach(el => entryObserver.observe(el));


  // ── 2. Animación de barras de progreso de alumnos ──
  // Anima las barras de progreso de la mini UI de alumnos
  // cuando entra en el viewport.
  const studentFills = document.querySelectorAll('.mini-student-fill');

  const barObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // La anchura ya está en el style="" inline,
          // solo necesitamos quitar el width:0 inicial si lo hay.
          (entry.target as HTMLElement).style.width = (entry.target as HTMLElement).style.width || '0%';
          barObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  studentFills.forEach(el => barObserver.observe(el));


  // ── 3. Hover 3D suave en el mockup ──
  // Elimina la animación CSS al hacer hover
  // para que la transición CSS tome el control.
  const mock = document.querySelector('.academy-mock');
  if (mock) {
    mock.addEventListener('mouseenter', () => {
      (mock as HTMLElement).style.animation = 'none';
    });
    mock.addEventListener('mouseleave', () => {
      (mock as HTMLElement).style.animation = '';
    });
  }


  // ── 4. PLACEHOLDER: Inicialización Lottie ──
  // Descomenta cuando tengas los archivos .json:
  /*
