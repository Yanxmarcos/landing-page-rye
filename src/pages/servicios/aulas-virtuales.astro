---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const service = services.find(s => s.slug === 'aulas-virtuales');
if (!service) throw new Error("Servicio 'aulas-virtuales' no encontrado.");

// Acento único: Índigo Educativo — aprendizaje, confianza, plataforma
---

<BaseLayout
  title={`${service.title} | Plataformas Educativas`}
  description={service.description}
>
  <div class="sp edu" data-theme>

    <!-- ═══════════════════════════════════════════
         HERO — Layout dos columnas
         Izquierda: copy | Derecha: mockup animado
    ════════════════════════════════════════════ -->
    <header class="sp__hero" aria-labelledby="hero-title">
      <!-- Fondo: grid de puntos + glow radial -->
      <div class="bg-grid"  aria-hidden="true"></div>
      <div class="bg-glow"  aria-hidden="true"></div>

      <div class="container hero-layout">

        <!-- ── Columna izquierda: Texto ── -->
        <div class="hero-copy" data-animate="fade-up">

          <span class="service-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            {service.tag}
          </span>

          <h1 class="hero-title" id="hero-title">
            Tu propia academia digital.
            <span class="hero-title__gradient">Cero comisiones.</span>
          </h1>

          <p class="hero-desc">{service.description}</p>

          <div class="hero-actions">
            <a href="/#contacto" class="btn-primary">
              <span>Crear mi academia</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="#demo" class="btn-ghost">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="10 8 16 12 10 16 10 8"/>
              </svg>
              Ver cómo funciona
            </a>
          </div>

          <!-- Métricas de prueba social -->
          <div class="hero-stats" aria-label="Métricas de la plataforma">
            <div class="stat-item">
              <strong class="stat-num">100%</strong>
              <span class="stat-label">Ingresos para ti</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <strong class="stat-num">0%</strong>
              <span class="stat-label">Comisiones por venta</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <strong class="stat-num">∞</strong>
              <span class="stat-label">Alumnos sin límite</span>
            </div>
          </div>

        </div>

        <!-- ── Columna derecha: Mockup interactivo ── -->
        <!--
          ZONA DE ANIMACIÓN — Hay 3 opciones para activar aquí:

          OPCIÓN A (Lottie):
            Instala: npm install @lottiefiles/lottie-player
            Reemplaza el <div class="platform-mockup"> por:
            <lottie-player
              id="edu-lottie"
              src="/animations/elearning-dashboard.json"
              background="transparent"
              speed="1"
              loop autoplay
              style="width:100%;height:auto;"
            ></lottie-player>
            Y al final añade: <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"><\/script>

          OPCIÓN B (Three.js):
            El contenedor #edu-canvas-container está listo.
            Añade al bloque <script> al final:
            import * as THREE from 'three';
            const canvas = document.getElementById('edu-canvas-container');
            // ... tu escena Three.js aquí

          OPCIÓN C (CSS puro — ya activo por defecto):
            El mockup de navegador de abajo ya anima con CSS.
            No requiere ninguna dependencia.
        -->
        <div class="hero-visual" data-animate="fade-left" aria-hidden="true">
          <div class="visual-wrapper" id="edu-canvas-container">

            <!-- Mockup: Dashboard de academia (CSS puro, listo para reemplazar) -->
            <div class="academy-mock">

              <!-- Barra lateral del dashboard -->
              <div class="mock-sidebar">
                <div class="mock-logo-area"></div>
                <nav class="mock-nav" aria-label="Navegación de demo">
                  <div class="mock-nav-item mock-nav-item--active">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Inicio
                  </div>
                  <div class="mock-nav-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    Cursos
                  </div>
                  <div class="mock-nav-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Alumnos
                  </div>
                  <div class="mock-nav-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Ingresos
                  </div>
                </nav>
              </div>

              <!-- Panel principal -->
              <div class="mock-main">
                <!-- Barra superior -->
                <div class="mock-topbar">
                  <div class="mock-topbar__title">Mi Academia</div>
                  <div class="mock-topbar__avatar"></div>
                </div>

                <!-- Tarjetas de métricas -->
                <div class="mock-metrics">
                  <div class="mock-metric-card mock-metric-card--accent">
                    <div class="mock-metric-label">Alumnos activos</div>
                    <div class="mock-metric-value">1,248</div>
                    <div class="mock-metric-delta">+12 esta semana</div>
                  </div>
                  <div class="mock-metric-card">
                    <div class="mock-metric-label">Ingresos del mes</div>
                    <div class="mock-metric-value">S/. 8,430</div>
                    <div class="mock-metric-delta">+23% vs anterior</div>
                  </div>
                </div>

                <!-- Barra de progreso simulada -->
                <div class="mock-progress-block">
                  <div class="mock-progress-label">
                    <span>Completación del curso activo</span>
                    <span>74%</span>
                  </div>
                  <div class="mock-progress-bar">
                    <div class="mock-progress-fill"></div>
                  </div>
                </div>

                <!-- Lista de cursos -->
                <div class="mock-courses">
                  {['Marketing Digital', 'Diseño UX', 'Excel Avanzado'].map((curso, i) => (
                    <div class="mock-course-row">
                      <div class="mock-course-thumb" style={`animation-delay:${i * 0.15}s`}></div>
                      <div class="mock-course-info">
                        <div class="mock-course-name">{curso}</div>
                        <div class="mock-course-bar">
                          <div class="mock-course-fill" style={`width:${[85,62,40][i]}%`}></div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

            </div>
            <!-- /academy-mock -->

            <!-- Tarjetas flotantes (se animan con CSS @keyframes) -->
            <div class="float-toast float-toast--tl" role="status" aria-live="polite">
              <div class="toast-icon toast-icon--success" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div class="toast-text">
                <strong>Nuevo alumno inscrito</strong>
                <span>Pago recibido: S/.99.00</span>
              </div>
            </div>

            <div class="float-toast float-toast--br" role="status" aria-live="polite">
              <div class="toast-icon toast-icon--info" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 4 12 14.01 9 11.01"/><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/></svg>
              </div>
              <div class="toast-text">
                <strong>María García completó</strong>
                <span>Módulo 1: Introducción ✓</span>
              </div>
            </div>

          </div>
        </div>
        <!-- /hero-visual -->

      </div>
    </header>


    <!-- ═══════════════════════════════════════════
         STORY — Problema / Solución (dark card)
    ════════════════════════════════════════════ -->
    <section class="sp__story section" aria-labelledby="story-title">
      <div class="container">
        <div class="story-card" data-animate="fade-up">

          <div class="story-content">
            <p class="story-eyebrow">El problema real</p>
            <h2 id="story-title" class="story-title">
              Las plataformas tradicionales se quedan con tu dinero
            </h2>
            <p class="story-desc">{service.detailedDescription}</p>
          </div>

          <div class="story-divider" aria-hidden="true"></div>

          <div class="story-stats" aria-label="Ventajas clave">
            <div class="story-stat">
              <strong class="story-stat__num">100%</strong>
              <span class="story-stat__label">Control de tus alumnos y datos</span>
            </div>
            <div class="story-stat">
              <strong class="story-stat__num">0%</strong>
              <span class="story-stat__label">Comisiones por cada venta</span>
            </div>
            <div class="story-stat">
              <strong class="story-stat__num">1 vez</strong>
              <span class="story-stat__label">Inversión sin mensualidades ocultas</span>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         FEATURES + BENTO + SIDEBAR (layout maestro)
    ════════════════════════════════════════════ -->
    <section class="sp__body section" id="demo" aria-labelledby="features-title">
      <div class="container body-layout">

        <!-- Columna principal -->
        <div class="body-main">

          <!-- Encabezado de sección -->
          <div class="body-header" data-animate="fade-up">
            <p class="body-eyebrow">Plataforma completa</p>
            <h2 id="features-title" class="body-title">Todo lo que necesitas para enseñar y vender</h2>
            <p class="body-desc">Herramientas diseñadas para que el aprendizaje fluya y tus ingresos crezcan solos.</p>
          </div>

          <!-- ──────────────────────────────────────────
               FEATURE CARDS RICAS
               Cada tarjeta tiene: ícono + texto + zona de media.
               La zona media está lista para Lottie o imagen.

               Para añadir Lottie a una card específica:
               1. Importa el player en <head> o instala el paquete.
               2. Reemplaza el <div class="feature-media"> de esa card:
                  <lottie-player src="/animations/nombre.json" background="transparent" speed="1" loop autoplay></lottie-player>
          ────────────────────────────────────────── -->
          <div class="features-list" data-animate="fade-up" role="list">

            {service.features?.map((feature, i) => (
              <article class="feature-card-rich" role="listitem">

                <!-- Texto -->
                <div class="feature-card__copy">
                  <div class="feature-icon-wrap" aria-hidden="true">
                    <!-- Íconos rotativos según índice -->
                    {i === 0 && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    )}
                    {i === 1 && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    )}
                    {i === 2 && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    )}
                    {i >= 3 && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    )}
                  </div>
                  <div class="feature-num" aria-hidden="true">0{i + 1}</div>
                  <h3 class="feature-title">{feature.title}</h3>
                  <p class="feature-desc">{feature.description}</p>
                </div>

                <!--
                  ZONA DE MEDIA — Lista para Lottie/imagen
                  Reemplaza el contenido interno por tu animación.
                  El contenedor mantendrá el tamaño y alineación.
                -->
                <div class="feature-card__media" aria-hidden="true">
                  <!-- Placeholder visual hasta tener la animación real -->
                  <div class="feature-media-inner">
                    <div class="feature-media-mockup">
                      <!-- Mini UI simulada específica para cada feature -->
                      {i === 0 && (
                        <div class="mini-ui mini-ui--video">
                          <div class="mini-play-btn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                          </div>
                          <div class="mini-progress-bar"><div class="mini-progress-fill" style="width:45%"></div></div>
                          <div class="mini-timeline">
                            <span>12:34</span><div class="mini-ticks"><span></span><span></span><span></span><span></span><span></span></div><span>28:00</span>
                          </div>
                        </div>
                      )}
                      {i === 1 && (
                        <div class="mini-ui mini-ui--students">
                          {['Ana R.', 'Carlos M.', 'Lucía P.', 'Pedro G.'].map((name, ni) => (
                            <div class="mini-student-row" style={`animation-delay:${ni * 0.2}s`}>
                              <div class="mini-avatar"></div>
                              <div class="mini-student-info">
                                <div class="mini-student-name">{name}</div>
                                <div class="mini-student-bar"><div class="mini-student-fill" style={`width:${[90, 65, 48, 82][ni]}%`}></div></div>
                              </div>
                              <div class="mini-student-pct">{[90, 65, 48, 82][ni]}%</div>
                            </div>
                          ))}
                        </div>
                      )}
                      {i === 2 && (
                        <div class="mini-ui mini-ui--revenue">
                          <div class="mini-rev-label">Ingresos del mes</div>
                          <div class="mini-rev-value">S/. 12,480</div>
                          <div class="mini-rev-bars">
                            {[40, 55, 45, 70, 60, 85, 95].map((h, bi) => (
                              <div class="mini-rev-bar" style={`height:${h}%;animation-delay:${bi * 0.07}s`}></div>
                            ))}
                          </div>
                        </div>
                      )}
                      {i >= 3 && (
                        <div class="mini-ui mini-ui--cert">
                          <div class="mini-cert-frame">
                            <div class="mini-cert-seal" aria-hidden="true">★</div>
                            <div class="mini-cert-lines">
                              <div class="mini-cert-line mini-cert-line--wide"></div>
                              <div class="mini-cert-line"></div>
                              <div class="mini-cert-line mini-cert-line--short"></div>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </div>

              </article>
            ))}

          </div>
          <!-- /features-list -->


          <!-- ──────────────────────────────────────────
               BENTO GRID — Audiencia objetivo
               El primer item ocupa 2 columnas (span 2) para crear
               la asimetría tipo Bento Box de Apple.
          ────────────────────────────────────────── -->
          <div class="audience-section" data-animate="fade-up">
            <p class="body-eyebrow">A quién va dirigido</p>
            <h3 class="audience-heading">Diseñado para escalar tu negocio educativo</h3>
            <div class="bento-grid" role="list">
              {service.targetAudience?.map((audience, idx) => (
                <article
                  class={`bento-item ${idx === 0 ? 'bento-item--featured' : ''}`}
                  role="listitem"
                  data-animate="fade-up"
                >
                  <div class="bento-icon" aria-hidden="true">
                    {idx === 0 && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>}
                    {idx === 1 && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>}
                    {idx === 2 && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
                    {idx >= 3 && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>}
                  </div>
                  <h4 class="bento-role">{audience.role}</h4>
                  <p class="bento-focus">{audience.focus}</p>
                </article>
              ))}
            </div>
          </div>

        </div>
        <!-- /body-main -->


        <!-- ══════════════════════════════
             SIDEBAR STICKY — Pricing card
        ═══════════════════════════════ -->
        <aside class="body-sidebar" aria-label="Plan y precio de la academia virtual">
          <div class="pricing-card">

            <div class="pricing-card__header">
              <p class="pricing-card__eyebrow">Plan Academia</p>
              <h3 class="pricing-card__title">Despliegue llave en mano</h3>
            </div>

            <dl class="pricing-meta">
              <div class="pricing-meta__row">
                <dt class="pricing-meta__label">Inversión desde</dt>
                <dd class="pricing-meta__value accent">{service.priceFrom}</dd>
              </div>
              <div class="pricing-meta__row">
                <dt class="pricing-meta__label">Entrega estimada</dt>
                <dd class="pricing-meta__value">{service.delivery}</dd>
              </div>
            </dl>

            <div class="pricing-benefits">
              <p class="pricing-benefits__title">El desarrollo incluye:</p>
              <ul class="checklist" role="list">
                {service.benefits.map(benefit => (
                  <li class="checklist__item" role="listitem">
                    <svg class="checklist__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5"/>
                    </svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a href="/#contacto" class="pricing-cta" aria-label="Agendar consultoría gratuita para academia virtual">
              Agendar consultoría gratuita
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>

            <p class="pricing-guarantee">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              Hosting seguro y escalable incluido
            </p>

          </div>
        </aside>

      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         CTA FINAL
    ════════════════════════════════════════════ -->
    <section class="sp__cta section" aria-labelledby="cta-title">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="container cta-inner">
        <h2 id="cta-title" class="cta-title">
          ¿Listo para lanzar tu propia plataforma educativa?
        </h2>
        <p class="cta-sub">
          Diseñamos y desarrollamos tu academia digital con todo incluido.
          Sin comisiones, sin límites de alumnos, 100% tuya.
        </p>
        <a href="/#contacto" class="btn-primary btn-primary--lg">
          <span>Crear mi academia ahora</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>


<!-- ═════════════════════════════════════════════════════
     ESTILOS — Sistema de temas + animaciones completas
════════════════════════════════════════════════════ -->
<style>
  /* ╔════════════════════════════════════════════╗
     ║  DESIGN TOKENS                             ║
     ║  Acento: Índigo Educativo — #6366F1        ║
     ║  Doble sistema: prefers-color-scheme       ║
     ║  y clase .dark en <html> o <body>          ║
     ╚════════════════════════════════════════════╝ */
  .edu {
    /* TEMA OSCURO (default) */
    --bg:           #07091A;
    --bg-alt:       #0D1028;
    --bg-card:      #111530;
    --bg-glass:     rgba(10,13,38,0.78);
    --bg-dark-card: #000718;
    --tx:           #E8ECFF;
    --tx-muted:     #8892C4;
    --tx-dim:       #3D4570;
    --border:       #1E2448;
    --shadow-sm:    0 1px 3px rgba(0,0,0,0.45);
    --shadow-md:    0 8px 24px rgba(0,0,0,0.55);
    --shadow-lg:    0 24px 60px rgba(0,0,0,0.65);
    --shadow-xl:    0 32px 80px rgba(0,0,0,0.70);
    --accent:       #6366F1;
    --accent-h:     #4F46E5;
    --accent-glow:  rgba(99,102,241,0.32);
    --accent-sub:   rgba(99,102,241,0.13);
    --accent-text:  #818CF8;
    --success:      #10B981;
    --success-sub:  rgba(16,185,129,0.15);
    --info:         #3B82F6;
    --info-sub:     rgba(59,130,246,0.15);
    --grid-color:   rgba(99,102,241,0.08);
  }

  :global([data-theme="light"]) .edu {
    --bg:           #FAFBFF;
    --bg-alt:       #F1F5FF;
    --bg-card:      #FFFFFF;
    --bg-glass:     rgba(255,255,255,0.72);
    --bg-dark-card: #0F172A;
    --tx:           #0C0F1E;
    --tx-muted:     #4B5275;
    --tx-dim:       #9BA3BF;
    --border:       #DDE2F5;
    --shadow-sm:    0 1px 3px rgba(12,15,30,0.07);
    --shadow-md:    0 8px 24px rgba(12,15,30,0.10);
    --shadow-lg:    0 24px 60px rgba(12,15,30,0.12);
    --shadow-xl:    0 32px 80px rgba(12,15,30,0.16);
    --accent-glow:  rgba(99,102,241,0.22);
    --accent-sub:   rgba(99,102,241,0.08);
    --accent-text:  #4338CA;
    --success-sub:  rgba(16,185,129,0.12);
    --info-sub:     rgba(59,130,246,0.12);
    --grid-color:   rgba(99,102,241,0.055);
  }

  /* ╔════════════════════════════════════════════╗
     ║  BASE                                      ║
     ╚════════════════════════════════════════════╝ */
  .sp {
    background-color: var(--bg);
    color: var(--tx);
    font-family: 'Inter', 'Helvetica Neue', system-ui, sans-serif;
    transition: background-color 0.35s ease, color 0.35s ease;
    overflow-x: hidden;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .section { padding-block: clamp(4.5rem, 9vw, 8rem); }


  /* ╔════════════════════════════════════════════╗
     ║  ANIMACIONES DE ENTRADA                    ║
     ║  Usa IntersectionObserver (script abajo)   ║
     ╚════════════════════════════════════════════╝ */
  [data-animate] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }
  [data-animate="fade-left"]  { transform: translateX(28px); }
  [data-animate="fade-up"]    { transform: translateY(28px); }
  [data-animate].is-visible {
    opacity: 1;
    transform: none;
  }


  /* ╔════════════════════════════════════════════╗
     ║  BOTONES GLOBALES                          ║
     ╚════════════════════════════════════════════╝ */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    box-shadow: 0 4px 14px var(--accent-glow);
  }
  .btn-primary:hover {
    background: var(--accent-h);
    box-shadow: 0 6px 22px var(--accent-glow);
    transform: translateY(-1px);
  }
  .btn-primary--lg { font-size: 1.0625rem; padding: 0.9rem 2rem; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tx-muted);
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .btn-ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-sub);
  }


  /* ╔════════════════════════════════════════════╗
     ║  HERO                                      ║
     ╚════════════════════════════════════════════╝ */
  .sp__hero {
    position: relative;
    padding-top: calc(clamp(4.5rem, 9vw, 8rem) + 4.5rem);
    padding-bottom: clamp(4.5rem, 9vw, 8rem);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  /* Fondo: grid de puntos */
  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, var(--grid-color) 1.5px, transparent 1.5px);
    background-size: 36px 36px;
    pointer-events: none;
  }

  /* Glow radial centrado arriba */
  .bg-glow {
    position: absolute;
    top: -240px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 68%);
    pointer-events: none;
  }

  /* Layout 2 columnas */
  .hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (min-width: 992px) {
    .hero-layout { grid-template-columns: 1fr 1.05fr; }
  }

  /* Badge */
  .service-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent-sub);
    color: var(--accent-text);
    border: 1px solid rgba(99,102,241,0.2);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.75rem;
  }

  /* Punto pulsante — animación CSS pura */
  .badge-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-ring 2.6s ease-in-out infinite;
  }
  @keyframes pulse-ring {
    0%         { box-shadow: 0 0 0 0   var(--accent-glow); }
    60%        { box-shadow: 0 0 0 8px rgba(99,102,241,0); }
    100%       { box-shadow: 0 0 0 0   rgba(99,102,241,0); }
  }

  /* Título con degradado */
  .hero-title {
    font-size: clamp(2.5rem, 4.5vw, 3.875rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--tx);
    margin-bottom: 1.25rem;
  }
  .hero-title__gradient {
    background: linear-gradient(125deg, var(--accent) 0%, #A855F7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.125rem;
    line-height: 1.68;
    color: var(--tx-muted);
    margin-bottom: 2.25rem;
    max-width: 54ch;
  }

  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.75rem; }

  /* Stats inline */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .stat-item  { display: flex; flex-direction: column; gap: 0.2rem; }
  .stat-num   { font-size: 1.5rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .stat-label { font-size: 0.78125rem; color: var(--tx-dim); }
  .stat-divider { width: 1px; height: 40px; background: var(--border); }


  /* ── Mockup Visual ── */
  .hero-visual { position: relative; }

  .visual-wrapper {
    position: relative;
    filter: drop-shadow(0 32px 64px rgba(12,15,30,0.18));
  }

  /* Mockup del dashboard */
  .academy-mock {
    display: grid;
    grid-template-columns: 80px 1fr;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    min-height: 380px;
    /* Efecto 3D sutil al cargar */
    animation: mockup-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes mockup-enter {
    from { transform: perspective(900px) rotateY(-8deg) rotateX(4deg) scale(0.96); opacity: 0; }
    to   { transform: perspective(900px) rotateY(0)     rotateX(0)    scale(1);    opacity: 1; }
  }
  .academy-mock:hover {
    /* El hover cancela la perspectiva suavemente */
    animation: none;
    transform: none;
    transition: transform 0.5s ease;
  }

  /* Sidebar del mock */
  .mock-sidebar {
    background: var(--bg-alt);
    border-right: 1px solid var(--border);
    padding: 1rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mock-logo-area {
    width: 36px; height: 36px;
    background: var(--accent);
    border-radius: 10px;
    margin: 0 auto 1rem;
    opacity: 0.85;
  }
  .mock-nav { display: flex; flex-direction: column; gap: 0.2rem; }
  .mock-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.5rem 0.25rem;
    border-radius: 8px;
    font-size: 0.55rem;
    color: var(--tx-dim);
    transition: background 0.2s, color 0.2s;
    cursor: default;
  }
  .mock-nav-item--active {
    background: var(--accent-sub);
    color: var(--accent);
  }

  /* Panel principal del mock */
  .mock-main {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1rem;
  }
  .mock-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mock-topbar__title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--tx);
  }
  .mock-topbar__avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.5;
  }

  .mock-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 0.625rem; }
  .mock-metric-card {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem;
  }
  .mock-metric-card--accent {
    background: var(--accent-sub);
    border-color: rgba(99,102,241,0.2);
  }
  .mock-metric-label { font-size: 0.55rem; color: var(--tx-dim); margin-bottom: 0.2rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .mock-metric-value { font-size: 0.875rem; font-weight: 800; color: var(--tx); line-height: 1; }
  .mock-metric-delta { font-size: 0.55rem; color: var(--success); margin-top: 0.2rem; font-weight: 600; }

  .mock-progress-block { }
  .mock-progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.6rem;
    color: var(--tx-dim);
    margin-bottom: 0.35rem;
  }
  .mock-progress-bar {
    height: 6px;
    background: var(--border);
    border-radius: 100px;
    overflow: hidden;
  }
  .mock-progress-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: 100px;
    animation: progress-grow 1.4s 0.8s cubic-bezier(0.22,1,0.36,1) forwards;
  }
  @keyframes progress-grow { to { width: 74%; } }

  .mock-courses { display: flex; flex-direction: column; gap: 0.5rem; }
  .mock-course-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .mock-course-thumb {
    width: 28px; height: 28px;
    border-radius: 6px;
    background: var(--accent-sub);
    border: 1px solid rgba(99,102,241,0.2);
    flex-shrink: 0;
    animation: thumb-pulse 3s ease-in-out infinite;
  }
  @keyframes thumb-pulse {
    0%,100% { opacity: 1; }
    50%      { opacity: 0.6; }
  }
  .mock-course-info { flex: 1; }
  .mock-course-name { font-size: 0.625rem; font-weight: 600; color: var(--tx); margin-bottom: 0.25rem; }
  .mock-course-bar  { height: 4px; background: var(--border); border-radius: 100px; overflow: hidden; }
  .mock-course-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), #A855F7);
    border-radius: 100px;
  }


  /* Toasts flotantes */
  .float-toast {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--bg-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.6875rem 1rem;
    box-shadow: var(--shadow-md);
    white-space: nowrap;
    /* Glassmorphism sutil — funciona especialmente bien en dark mode */
  }
  .float-toast--tl {
    top: -14px;
    left: -14px;
    animation: float-y 5s ease-in-out infinite;
  }
  .float-toast--br {
    bottom: -14px;
    right: -14px;
    animation: float-y 5s ease-in-out infinite 2.5s;
  }
  @keyframes float-y {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  .toast-icon {
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .toast-icon--success { background: var(--success-sub); color: var(--success); }
  .toast-icon--info    { background: var(--info-sub);    color: var(--info); }

  .toast-text strong { display: block; font-size: 0.75rem; font-weight: 700; color: var(--tx); }
  .toast-text span   { font-size: 0.6875rem; color: var(--tx-muted); }


  /* ╔════════════════════════════════════════════╗
     ║  STORY (Problema/Solución)                 ║
     ╚════════════════════════════════════════════╝ */
  .sp__story { }

  .story-card {
    background: var(--bg-dark-card);
    border-radius: 24px;
    padding: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    box-shadow: var(--shadow-xl);
    /* Borde con glow sutil en dark */
    border: 1px solid rgba(99,102,241,0.15);
    position: relative;
    overflow: hidden;
  }

  /* Glow interno en la esquina superior */
  .story-card::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(99,102,241,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .story-card {
      flex-direction: row;
      align-items: center;
    }
    .story-content   { flex: 3; }
    .story-divider   { width: 1px; align-self: stretch; background: rgba(255,255,255,0.08); }
    .story-stats     { flex: 2; padding-left: 2rem; }
  }

  .story-eyebrow {
    font-size: 0.78125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.75rem;
    /* En dark card, el acento siempre contrasta bien */
  }
  .story-title {
    font-size: clamp(1.5rem, 2.5vw, 2.125rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    /* Blanco siempre — la card es siempre oscura */
    color: #F1F5FF;
    margin-bottom: 1rem;
  }
  .story-desc {
    font-size: 1.0625rem;
    line-height: 1.72;
    /* Texto claro sobre fondo oscuro */
    color: #8892C4;
  }

  .story-stats { display: flex; flex-direction: column; gap: 1.75rem; }
  .story-stat { }
  .story-stat__num {
    display: block;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .story-stat__label {
    font-size: 0.875rem;
    color: #8892C4;
    line-height: 1.4;
  }


  /* ╔════════════════════════════════════════════╗
     ║  BODY (Features + Bento + Sidebar)         ║
     ╚════════════════════════════════════════════╝ */
  .body-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .body-layout { grid-template-columns: 1fr 360px; }
  }

  .body-header   { margin-bottom: 3.5rem; }
  .body-eyebrow  {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .body-title    {
    font-size: clamp(1.875rem, 3vw, 2.625rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--tx);
    margin-bottom: 0.875rem;
  }
  .body-desc     {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--tx-muted);
    max-width: 64ch;
  }


  /* ── Feature Cards Ricas ── */
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 5rem;
  }

  .feature-card-rich {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .feature-card-rich:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md), 0 0 0 3px var(--accent-sub);
  }
  @media (min-width: 640px) {
    .feature-card-rich { grid-template-columns: 1fr 1fr; }
  }

  /* Glassmorphism en dark */
  @media (prefers-color-scheme: dark) {
    .feature-card-rich {
      background: var(--bg-glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }
  :global(.dark) .feature-card-rich {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .feature-card__copy {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-icon-wrap {
    width: 48px; height: 48px;
    background: var(--accent-sub);
    color: var(--accent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .feature-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: 0.625rem;
    font-variant-numeric: tabular-nums;
  }

  .feature-title {
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--tx);
    margin-bottom: 0.625rem;
  }
  .feature-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--tx-muted);
    margin: 0;
  }

  /* Zona de media — contenedor para Lottie/imagen */
  .feature-card__media {
    background: var(--bg-alt);
    border-left: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    padding: 1.5rem;
  }
  @media (max-width: 639px) {
    .feature-card__media { border-left: none; border-top: 1px solid var(--border); }
  }

  .feature-media-inner { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .feature-media-mockup { width: 100%; max-width: 240px; }


  /* ─── Mini UIs animadas (CSS puro) ─── */

  /* 1 — Video player */
  .mini-ui--video {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .mini-play-btn {
    width: 52px; height: 52px;
    background: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin: 0 auto;
    cursor: default;
    animation: play-pulse 3s ease-in-out infinite;
    box-shadow: 0 4px 16px var(--accent-glow);
  }
  @keyframes play-pulse {
    0%,100% { transform: scale(1); box-shadow: 0 4px 16px var(--accent-glow); }
    50%      { transform: scale(1.06); box-shadow: 0 6px 24px var(--accent-glow); }
  }
  .mini-progress-bar {
    height: 6px;
    background: var(--border);
    border-radius: 100px;
    overflow: hidden;
  }
  .mini-progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 100px;
    animation: vid-seek 8s linear infinite;
  }
  @keyframes vid-seek {
    0%   { width: 0%; }
    80%  { width: 100%; }
    100% { width: 0%; }
  }
  .mini-timeline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6rem;
    color: var(--tx-dim);
  }
  .mini-ticks { display: flex; gap: 0.3rem; }
  .mini-ticks span {
    width: 2px; height: 8px;
    background: var(--border);
    border-radius: 1px;
    display: block;
  }

  /* 2 — Progreso de alumnos */
  .mini-ui--students {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mini-student-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    animation: row-slide-in 0.5s both;
  }
  @keyframes row-slide-in {
    from { opacity: 0; transform: translateX(-8px); }
    to   { opacity: 1; transform: none; }
  }
  .mini-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #A855F7);
    flex-shrink: 0;
  }
  .mini-student-info { flex: 1; }
