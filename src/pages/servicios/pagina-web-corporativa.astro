---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const service = services.find(s => s.slug === 'pagina-web-corporativa');
if (!service) throw new Error("Servicio 'pagina-web-corporativa' no encontrado.");

// ============================================================
// GALERÍA DE IMÁGENES INTERACTIVA
// Agrega tus screenshots en public/images/corp/
// Formato recomendado: JPG/WebP, 1400×900px mínimo
// ============================================================
const gallerySlides = [
  {
    label:    'Estudio Legal · Lima',
    url:      'estudio-ramos.pe',
    img:      '/ramos.png',
    category: 'Legal & Corporativo',
  },
  {
    label:    'Weddings Estructuras· Trujillo',
    url:      'https://weldingestructuras.com/',
    img:      '/images/estructuras.png',
    category: 'Mecánica & Diseño',
  },
  {
    label:    'Consultora Financiera · Lima',
    url:      'financorp.pe',
    img:      '/finacorp.png',
    category: 'Finanzas & Consultoría',
  },
  {
    label:    'Arquitectura & Diseño · Lima',
    url:      'arq-studio.pe',
    img:      '/arq.png',
    category: 'Arquitectura & Diseño',
  },
];

// ============================================================
// AUDIENCIA OBJETIVO
// Agrega fotos PNG con fondo transparente para mejor resultado
// Colócalas en: public/images/audience/
// ============================================================
const audience = [
  {
    img:       '/images/tech.png',
    initials:  'GG',
    role:      'Emprendedor Tecnológico',
    focus:     'Emprendedor que lanzó una nueva startup tecnológica y necesita una presencia web sólida para atraer inversionistas y clientes potenciales a su innovadora solución',
    tag:       'Emprendedores technológicos',
    tagColor:  '#2563EB',
    tagBg:     'rgba(37,99,235,0.1)',
    circle:    'radial-gradient(circle at 50% 85%, #2563EB, #1D4ED8)',
    device:    'laptop',
    accent:    '#2563EB',
  },
  {
    img:       '/images/inmobiliaria.png',
    initials:  'RP',
    role:      'Agente Inmobiliario',
    focus:     'Agente inmobiliario que requiere una plataforma digital impactante para mostrar sus propiedades, generar leads y destacar entre la competencia local.',
    tag:       'Agentes inmobiliarios',
    tagColor:  '#F5A623',
    tagBg:     'rgba(245,166,35,0.1)',
    circle:    'radial-gradient(circle at 50% 85%, #F5A623, #D4891A)',
    device:    'phone',
    accent:    '#F5A623',
  },
  {
    img:       '/images/diseñador.png',
    initials:  'PF',
    role:      'Diseñador Gráfico Freelance',
    focus:     'Diseñador gráfico independiente que busca una identidad digital profesional y un portafolio en línea que le permita atraer clientes de alto perfil y expandir su negocio.',
    tag:       'Profesionales independientes',
    tagColor:  '#0D9488',
    tagBg:     'rgba(13,148,136,0.1)',
    circle:    'radial-gradient(circle at 50% 85%, #0D9488, #0B7A70)',
    device:    'laptop',
    accent:    '#0D9488',
  },
];
---

<BaseLayout
  title={`${service.title} | RYE WEB`}
  description={service.description}
>
  <div class="corp sp">

    <!-- =====================================================
         HERO
    ===================================================== -->
    <header class="corp__hero section" aria-labelledby="hero-title">
      <div class="bg-grid" aria-hidden="true"></div>
      <div class="bg-glow" aria-hidden="true"></div>

      <div class="container hero-layout">
        <div class="hero-copy" data-animate="fade-up">
          <span class="service-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            {service.tag}
          </span>

          <h1 class="hero-title" id="hero-title">{service.title}</h1>
          <p class="hero-desc">{service.description}</p>

          <div class="hero-actions">
            <a href="/#contacto" class="btn-primary">
              Solicitar Propuesta
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#galeria" class="btn-ghost">Ver ejemplos</a>
          </div>

         
        </div>

        <!-- Visual browser mockup -->
        <div class="hero-visual" data-animate="fade-left" aria-hidden="true">
          <div class="visual-frame">
            <div class="mock-browser">
              <div class="mock-browser__bar">
                <span class="mock-dot" style="background:#FF5F56"></span>
                <span class="mock-dot" style="background:#FFBD2E"></span>
                <span class="mock-dot" style="background:#27C93F"></span>
                <div class="mock-url">tuempresa.com</div>
              </div>
              <div class="mock-browser__screen">
                <div class="mock-nav"></div>
                <div class="mock-hero-block">
                  <div class="mock-line mock-line--title"></div>
                  <div class="mock-line mock-line--sub"></div>
                  <div class="mock-btn-row"><div class="mock-btn-el"></div></div>
                </div>
                <div class="mock-cards-row">
                  <div class="mock-card"></div>
                  <div class="mock-card"></div>
                  <div class="mock-card"></div>
                </div>
              </div>
            </div>
            <div class="float-badge float-badge--tl">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              SEO Optimizado
            </div>
            <div class="float-badge float-badge--br">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              Core Web Vitals: 100
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- =====================================================
         GALERÍA INTERACTIVA DE IMÁGENES
         Instrucciones:
         1. Coloca tus screenshots en public/images/corp/
         2. Nombra los archivos igual que en gallerySlides arriba
         3. Si la imagen no existe, se muestra un placeholder
    ===================================================== -->
    <section class="corp__gallery section" id="galeria" aria-labelledby="gallery-title">
      <div class="container">
        <header class="section-header--left">
          <p class="section-eyebrow">Trabajos de ejemplo</p>
          <h2 id="gallery-title" class="section-title">Diseños que transmiten autoridad</h2>
         
        </header>

        <div class="img-gallery" data-animate="fade-up">
          <!-- Barra browser -->
          <div class="gallery-topbar">
            <div class="gallery-dots-bar">
              <span style="background:#ef4444"></span>
              <span style="background:#f59e0b"></span>
              <span style="background:#10b981"></span>
            </div>
            <div class="gallery-url-bar">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <rect x="1" y="3" width="8" height="6" rx="1.5" stroke="#10b981" stroke-width="1.2"/>
                <path d="M3.5 3V2.5a1.5 1.5 0 013 0V3" stroke="#10b981" stroke-width="1.2"/>
              </svg>
              <span id="gallery-url">{gallerySlides[0].url}</span>
            </div>
            <!-- Categoría del slide -->
            <span class="gallery-category" id="gallery-category">{gallerySlides[0].category}</span>
          </div>

          <!-- Viewport con slides -->
          <div class="gallery-viewport" id="gallery-viewport">
            {gallerySlides.map((slide, i) => (
              <div
                class:list={['gallery-slide', i === 0 && 'gallery-slide--active']}
                data-label={slide.label}
                data-url={slide.url}
                data-category={slide.category}
              >
                <!-- Imagen real -->
                <img
                  src={slide.img}
                  alt={slide.label}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="gallery-slide__img"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <!-- Placeholder si no hay imagen -->
                <div class="gallery-slide__placeholder" style="display:none;">
                  <div class="placeholder-icon" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                      <rect x="2" y="4" width="24" height="17" rx="3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M10 25h8M14 21v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <strong>{slide.label}</strong>
                  <span>Agrega tu imagen en:</span>
                  <code>{slide.img}</code>
                </div>
              </div>
            ))}

            <!-- Botones de navegación -->
            <div class="gallery-nav" aria-hidden="true">
              <button class="gallery-arrow gallery-arrow--prev" id="gallery-prev" aria-label="Imagen anterior">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="gallery-arrow gallery-arrow--next" id="gallery-next" aria-label="Imagen siguiente">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Footer con dots y label -->
          <div class="gallery-footer">
            <span class="gallery-label" id="gallery-label">{gallerySlides[0].label}</span>
            <div class="gallery-dots-nav" id="gallery-dots">
              {gallerySlides.map((_, i) => (
                <button
                  class:list={['gallery-dot', i === 0 && 'gallery-dot--active']}
                  data-slide={i}
                  aria-label={`Ir al slide ${i + 1}`}
                />
              ))}
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- =====================================================
         AUDIENCIA — personas con círculo + dispositivo
         Instrucciones para las fotos:
         - Usa PNG con fondo transparente para mejor resultado
         - Tamaño recomendado: 300×400px
         - Carpeta: public/images/audience/
    ===================================================== -->
    <section class="corp__audience section bg-alt" aria-labelledby="audience-title">
      <div class="container">
        <header class="section-header">
          <p class="section-eyebrow">Audiencia objetivo</p>
          <h2 id="audience-title" class="section-title">¿Para quién es este servicio?</h2>
          <p class="section-sub">Diseñado para empresas que necesitan autoridad digital para cerrar grandes cuentas.</p>
        </header>

        <div class="audience-grid">
          {audience.map(person => (
            <article class="audience-card" data-animate="fade-up">

              <!-- Área visual: círculo + persona + dispositivo -->
              <div class="aud-visual">
                <!-- Círculo de color de fondo -->
                <div
                  class="aud-circle"
                  style={`background:${person.circle};`}
                  aria-hidden="true"
                ></div>

                <!-- Foto de la persona -->
                <img
                  src={person.img}
                  alt={person.role}
                  class="aud-person"
                  loading="lazy"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <!-- Placeholder avatar -->
                <div class="aud-avatar-placeholder" style="display:none;" aria-hidden="true">
                  <span class="aud-initials">{person.initials}</span>
                  <span class="aud-placeholder-hint">
                    {person.img.split('/').pop()}
                  </span>
                </div>

                <!-- Dispositivo flotante (laptop o phone) -->
                {person.device === 'laptop' ? (
                  <div class="aud-device aud-device--laptop" aria-hidden="true">
                    <div class="aud-laptop-body">
                      <div class="aud-screen">
                        <div class="screen-line" style={`background:${person.accent};`}></div>
                        <div class="screen-line screen-line--muted"></div>
                        <div class="screen-line screen-line--short screen-line--muted"></div>
                      </div>
                    </div>
                    <div class="aud-laptop-base"></div>
                    <div class="aud-laptop-foot"></div>
                  </div>
                ) : (
                  <div class="aud-device aud-device--phone" aria-hidden="true">
                    <div class="aud-phone-body">
                      <div class="aud-phone-notch"></div>
                      <div class="aud-screen aud-screen--phone">
                        <div class="screen-line" style={`background:${person.accent};width:80%;`}></div>
                        <div class="screen-line screen-line--muted"></div>
                        <div class="screen-line screen-line--short screen-line--muted"></div>
                      </div>
                      <div class="aud-phone-bar"></div>
                    </div>
                  </div>
                )}
              </div>

              <!-- Información del perfil -->
              <div class="aud-info">
                <h3 class="aud-role">{person.role}</h3>
                <p class="aud-focus">{person.focus}</p>
                <span
                  class="aud-tag"
                  style={`color:${person.tagColor}; background:${person.tagBg};`}
                >
                  {person.tag}
                </span>
              </div>

            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- =====================================================
         BENEFICIOS + SIDEBAR
    ===================================================== -->
    <section class="corp__body section" id="detalles" aria-labelledby="body-title">
      <div class="container body-layout">

        <div class="body-main">
          <p class="body-eyebrow">Qué construimos</p>
          <h2 id="body-title" class="body-title">El motor de tu presencia digital</h2>
          <p class="body-desc">{service.description}</p>

          <div class="benefits-list" data-animate="fade-up">
            {service.benefits.map(benefit => (
              <div class="benefit-row">
                <span class="benefit-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6l2.8 2.8 5.2-5.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="benefit-text">{benefit}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="body-sidebar">
          <div class="pricing-card">
            <div class="pricing-card__header">
              <p class="pricing-card__eyebrow">Inversión</p>
              <h3 class="pricing-card__title">Transparencia total</h3>
            </div>
            <dl class="pricing-meta">
              <div class="pricing-meta__row">
                <dt class="pricing-meta__label">Precio desde</dt>
                <dd class="pricing-meta__value accent">{service.priceFrom}</dd>
              </div>
              <div class="pricing-meta__row">
                <dt class="pricing-meta__label">Tiempo de entrega</dt>
                <dd class="pricing-meta__value">{service.delivery}</dd>
              </div>
            </dl>
            <div class="pricing-includes">
              <p class="pricing-includes__title">¿Qué incluye?</p>
              <ul class="checklist">
                {service.benefits.map(pill => (
                  <li class="checklist__item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M2 7l3.5 3.5 6.5-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {pill}
                  </li>
                ))}
              </ul>
            </div>
            <a href="/#contacto" class="pricing-cta">
              Cotizar mi proyecto
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <path d="M2 7.5h11M9 3l4.5 4.5L9 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <p class="pricing-guarantee">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                <path d="M6.5 12S11 9 11 5.5V2.5L6.5 1 2 2.5v3C2 9 6.5 12 6.5 12z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Soporte post-lanzamiento 30 días
            </p>
          </div>
        </aside>

      </div>
    </section>

    <!-- =====================================================
         CTA FINAL
    ===================================================== -->
    <section class="corp__cta section" aria-labelledby="cta-title">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="container cta-inner">
        <h2 id="cta-title" class="cta-title">¿Listo para construir tu presencia digital?</h2>
        <p class="cta-sub">Hablemos sobre cómo una web corporativa de alto nivel puede posicionarte por encima de tu competencia.</p>
        <a href="/#contacto" class="btn-primary btn-primary--lg">
          Iniciar mi proyecto
          <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
            <path d="M3 8.5h11M9 4l5 4.5L9 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<!-- =========================================================
     SCRIPTS
========================================================= -->
<script>
  /* ---- Galería interactiva ----------------------------- */
  const slides    = document.querySelectorAll<HTMLElement>('.gallery-slide');
  const dots      = document.querySelectorAll<HTMLButtonElement>('.gallery-dot');
  const urlEl     = document.getElementById('gallery-url')!;
  const labelEl   = document.getElementById('gallery-label')!;
  const catEl     = document.getElementById('gallery-category')!;

  let current = 0;
  let autoTimer = setInterval(() => goSlide((current + 1) % slides.length), 4000);

  function goSlide(n: number) {
    slides[current].classList.remove('gallery-slide--active');
    slides[current].classList.add('gallery-slide--exit');
    setTimeout(() => slides[current].classList.remove('gallery-slide--exit'), 550);

    current = (n + slides.length) % slides.length;
    slides[current].classList.add('gallery-slide--active');

    dots.forEach((d, i) => d.classList.toggle('gallery-dot--active', i === current));
    urlEl.textContent   = slides[current].dataset.url   ?? '';
    labelEl.textContent = slides[current].dataset.label ?? '';
    catEl.textContent   = slides[current].dataset.category ?? '';

    clearInterval(autoTimer);
    autoTimer = setInterval(() => goSlide((current + 1) % slides.length), 4000);
  }

  document.getElementById('gallery-prev')?.addEventListener('click', () => goSlide(current - 1));
  document.getElementById('gallery-next')?.addEventListener('click', () => goSlide(current + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goSlide(i)));

  /* ---- Animaciones de entrada ------------------------- */
  const animEls = document.querySelectorAll('[data-animate]');
  const observer = new IntersectionObserver(entries => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('is-visible'), (i % 4) * 80);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  animEls.forEach(el => observer.observe(el));
</script>

<style>
  /* =====================================================
     DESIGN TOKENS — Claro / Oscuro
  ===================================================== */
  .corp {
    --bg:         #080E1A;
    --bg-alt:     #0E1726;
    --bg-card:    #131F33;
    --bg-glass:   rgba(13,22,41,0.75);
    --tx:         #F0F6FF;
    --muted:      #8B9BB4;
    --dim:        #4B5E78;
    --border:     #1E2D45;
    --shadow-sm:  0 1px 3px rgba(0,0,0,.4);
    --shadow-md:  0 8px 24px rgba(0,0,0,.5);
    --shadow-lg:  0 24px 60px rgba(0,0,0,.6);
    --accent:     #2563EB;
    --accent-h:   #1D4ED8;
    --accent-glow:rgba(37,99,235,.30);
    --accent-sub: rgba(37,99,235,.12);
    --grid-color: rgba(37,99,235,.07);

    background: var(--bg);
    color: var(--tx);
    transition: background .35s ease, color .35s ease;
    overflow-x: hidden;
  }

  :global([data-theme="light"]) .corp {
    --bg:         #FFFFFF;
    --bg-alt:     #F8FAFD;
    --bg-card:    #FFFFFF;
    --bg-glass:   rgba(255,255,255,.85);
    --tx:         #0D1117;
    --muted:      #4B5563;
    --dim:        #9CA3AF;
    --border:     #E5E7EB;
    --shadow-sm:  0 1px 3px rgba(13,17,23,.08);
    --shadow-md:  0 8px 24px rgba(13,17,23,.10);
    --shadow-lg:  0 24px 60px rgba(13,17,23,.12);
    --accent-glow:rgba(37,99,235,.18);
    --accent-sub: rgba(37,99,235,.08);
    --grid-color: rgba(37,99,235,.05);
  }

  /* ---- Base ------------------------------------------- */
  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .section { padding-block: clamp(4rem, 8vw, 7rem); }
  .bg-alt  { background: var(--bg-alt); }

  /* Animaciones */
  [data-animate] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .6s ease, transform .6s ease;
  }
  [data-animate="fade-left"]   { transform: translateX(24px); }
  [data-animate].is-visible    { opacity: 1; transform: none; }

  code {
    font-family: 'Fira Code', monospace;
    font-size: 0.78rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 6px;
    color: var(--accent);
  }

  /* ---- Botones ---------------------------------------- */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background .2s, box-shadow .2s, transform .15s;
    box-shadow: 0 4px 14px var(--accent-glow);
  }
  .btn-primary:hover { background: var(--accent-h); transform: translateY(-1px); }
  .btn-primary--lg   { font-size: 1.0625rem; padding: 0.9rem 2rem; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: var(--muted);
    font-weight: 500;
    font-size: 0.9375rem;
    padding: .75rem 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color .2s, border-color .2s, background .2s;
  }
  .btn-ghost:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-sub); }

  /* ---- Headers ---------------------------------------- */
  .section-header { text-align: center; margin-bottom: 3.5rem; }
  .section-header--left { margin-bottom: 2rem; }
  .section-eyebrow {
    font-size: 0.78rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .08em;
    color: var(--accent); margin-bottom: .6rem;
  }
  .section-title {
    font-family: var(--font-display, 'Clash Display', system-ui);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800; letter-spacing: -.025em;
    color: var(--tx); margin-bottom: .75rem;
  }
  .section-sub { font-size: 1rem; color: var(--muted); max-width: 56ch; line-height: 1.7; }
