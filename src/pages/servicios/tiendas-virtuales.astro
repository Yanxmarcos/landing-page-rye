---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';

const service = services.find(s => s.slug === 'tiendas-virtuales');
if (!service) throw new Error("Servicio 'tiendas-virtuales' no encontrado.");

// --- AÑADE ESTO: Arreglo de imágenes para el mockup ---
const mockProducts = [
  { img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300&q=80", alt: "Producto 1" },
  { img: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=300&q=80", alt: "Producto 2" },
  { img: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=300&q=80", alt: "Producto 3" },
  { img: "https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=300&q=80", alt: "Producto 4" }
];
---

<BaseLayout
  title={`${service.title} | Agencia Elite`}
  description={service.description}
>
  <div class="sp ecom" data-theme>

    <!-- ░░ HERO ░░ -->
    <header class="sp__hero section" aria-labelledby="hero-title">
      <div class="bg-grid" aria-hidden="true"></div>
      <div class="bg-glow" aria-hidden="true"></div>

      <div class="container hero-layout">
        <div class="hero-copy" data-animate="fade-up">
          <span class="service-badge">
            <span class="badge-dot" aria-hidden="true"></span>
            {service.tag}
          </span>
          <h1 class="hero-title" id="hero-title">
            {service.title} <span class="hero-title__highlight">Pro</span>
          </h1>
          <p class="hero-desc">{service.description}</p>
          <div class="hero-actions">
            <a href="/#contacto" class="btn-primary">
              <span>Abrir mi tienda</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#detalles" class="btn-ghost">Ver funcionalidades</a>
          </div>
         
        </div>

        <!-- Visual: Mockup tienda -->
        <div class="hero-visual" data-animate="fade-left" aria-hidden="true">
          <div class="visual-frame" id="ecom-canvas-container">
            <div class="store-mock">
              <div class="store-mock__topbar">
                <div class="store-mock__logo"></div>
                <div class="store-mock__nav">
                  <div class="nav-item"></div><div class="nav-item"></div><div class="nav-item"></div>
                </div>
                <div class="store-mock__cart">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                  <span class="cart-count">3</span>
                </div>
              </div>
             
              <div class="store-mock__products">
                {/* --- CAMBIA EL MAP POR ESTE --- */}
                {mockProducts.map(product => (
                  <div class="product-card-mock">
                    <div class="product-img-mock">
                      <img src={product.img} alt={product.alt} loading="lazy" />
                    </div>
                    <div class="product-info-mock">
                      <div class="product-name-mock"></div>
                      <div class="product-price-mock"></div>
                    </div>
                    <div class="product-btn-mock">Añadir</div>
                  </div>
                ))}
              </div>


            <div class="float-badge float-badge--tl">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              Pago seguro SSL
            </div>
            <div class="float-badge float-badge--br">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              +S/. 12,400 esta semana
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ░░ AUDIENCIA ░░ -->
    <section class="sp__audience section bg-alt" aria-labelledby="audience-title">
      <div class="container">
        <header class="section-header">
          <p class="section-eyebrow">A quién ayudamos</p>
          <h2 id="audience-title" class="section-title">¿Para quién es este servicio?</h2>
          <p class="section-sub">Para emprendedores y marcas que quieren vender en línea de manera profesional y escalable.</p>
        </header>
        <div class="audience-grid" role="list">
          {service.targetAudience?.map(audience => (
            <article class="audience-card" role="listitem" data-animate="fade-up">
              <div class="audience-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <h3 class="audience-role">{audience.role}</h3>
              <p class="audience-focus">{audience.focus}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ CUERPO + SIDEBAR ░░ -->
    <section class="sp__body section" id="detalles" aria-labelledby="body-title">
      <div class="container body-layout">
        <div class="body-main">
          <div class="body-block" data-animate="fade-up">
            <p class="body-eyebrow">Plataforma completa</p>
            <h2 id="body-title" class="body-title">Tu tienda, funcionando a máxima potencia</h2>
            <p class="body-desc">{service.detailedDescription}</p>
          </div>
          <div class="features-section" data-animate="fade-up">
            <h3 class="features-heading">Funcionalidades incluidas</h3>
            <div class="features-grid" role="list">
              {service.features?.map((feature, i) => (
                <article class="feature-card" role="listitem">
                  <div class="feature-lottie-slot" aria-hidden="true">
                    <span class="feature-index">0{i + 1}</span>
                  </div>
                  <div class="feature-body">
                    <h4 class="feature-title">{feature.title}</h4>
                    <p class="feature-desc">{feature.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <aside class="body-sidebar" aria-label="Precio y contacto">
          <div class="pricing-card">
            <div class="pricing-card__header">
              <p class="pricing-card__eyebrow">Inversión</p>
              <h3 class="pricing-card__title">Tu tienda lista para vender</h3>
            </div>
            <dl class="pricing-meta">
              <div class="pricing-meta__row">
                <dt class="pricing-meta__label">Precio desde</dt>
                <dd class="pricing-meta__value accent">{service.priceFrom}</dd>
              </div>
              <div class="pricing-meta__row">
                <dt class="pricing-meta__label">Tiempo de entrega</dt>
                <dd class="pricing-meta__value">{service.delivery}</dd>
              </div>
            </dl>
            <div class="pricing-benefits">
              <p class="pricing-benefits__title">¿Qué incluye?</p>
              <ul class="checklist" role="list">
                {service.benefits.map(benefit => (
                  <li class="checklist__item" role="listitem">
                    <svg class="checklist__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a href="/#contacto" class="pricing-cta" aria-label="Cotizar tienda virtual">
              Cotizar mi tienda
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <p class="pricing-guarantee">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Integración de pasarela de pago incluida
            </p>
          </div>
        </aside>
      </div>
    </section>

    <!-- ░░ CTA ░░ -->
    <section class="sp__cta section" aria-labelledby="cta-title">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="container cta-inner">
        <h2 id="cta-title" class="cta-title">Tu tienda online, abierta los 365 días del año</h2>
        <p class="cta-sub">Construimos la plataforma de e-commerce que tu marca merece, con todo lo necesario para escalar.</p>
        <a href="/#contacto" class="btn-primary btn-primary--lg">
          <span>Abrir mi tienda ahora</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ── Tokens: Violeta Profundo ── */
  .ecom {
    /* TEMA OSCURO (default) */
    --bg:          #080412;
    --bg-alt:      #0D0820;
    --bg-card:     #130D28;
    --bg-glass:    rgba(12,8,30,0.75);
    --tx:          #F3EEFF;
    --tx-muted:    #A890D0;
    --tx-dim:      #5A4880;
    --border:      #1E1240;
    --shadow-sm:   0 1px 3px rgba(0,0,0,0.4);
    --shadow-md:   0 8px 24px rgba(0,0,0,0.5);
    --shadow-lg:   0 24px 60px rgba(0,0,0,0.6);
    --accent:      #7C3AED;
    --accent-h:    #6D28D9;
    --accent-glow: rgba(124,58,237,0.30);
    --accent-sub:  rgba(124,58,237,0.12);
    --grid-color:  rgba(124,58,237,0.08);
  }

  :global([data-theme="light"]) .ecom {
    --bg:          #FFFFFF;
    --bg-alt:      #FAF8FF;
    --bg-card:     #FFFFFF;
    --bg-glass:    rgba(255,255,255,0.7);
    --tx:          #12082A;
    --tx-muted:    #5B4E73;
    --tx-dim:      #9C8FB0;
    --border:      #EDE8F8;
    --shadow-sm:   0 1px 3px rgba(18,8,42,0.07);
    --shadow-md:   0 8px 24px rgba(18,8,42,0.10);
    --shadow-lg:   0 24px 60px rgba(18,8,42,0.12);
    --accent-glow: rgba(124,58,237,0.22);
    --accent-sub:  rgba(124,58,237,0.07);
    --grid-color:  rgba(124,58,237,0.05);
  }

  /* BASE */
  .sp { background:var(--bg); color:var(--tx); font-family:'Inter','Helvetica Neue',system-ui,sans-serif; transition:background .35s,color .35s; overflow-x:hidden; }
  .container { width:100%; max-width:1200px; margin-inline:auto; padding-inline:1.5rem; }
  .section { padding-block:clamp(4rem,8vw,7rem); }
  .bg-alt { background:var(--bg-alt); }
  [data-animate] { opacity:0; transform:translateY(24px); transition:opacity .6s ease,transform .6s ease; }
  [data-animate="fade-left"] { transform:translateX(24px); }
  [data-animate].is-visible { opacity:1; transform:none; }

  /* BOTONES */
  .btn-primary { display:inline-flex; align-items:center; gap:.5rem; background:var(--accent); color:#fff; font-weight:600; font-size:.9375rem; padding:.75rem 1.5rem; border-radius:10px; text-decoration:none; transition:background .2s,box-shadow .2s,transform .15s; box-shadow:0 4px 14px var(--accent-glow); }
  .btn-primary:hover { background:var(--accent-h); box-shadow:0 6px 20px var(--accent-glow); transform:translateY(-1px); }
  .btn-primary--lg { font-size:1.0625rem; padding:.9rem 2rem; }
  .btn-ghost { display:inline-flex; align-items:center; gap:.5rem; color:var(--tx-muted); font-weight:500; font-size:.9375rem; padding:.75rem 1.25rem; border-radius:10px; border:1px solid var(--border); text-decoration:none; transition:color .2s,border-color .2s,background .2s; }
  .btn-ghost:hover { color:var(--accent); border-color:var(--accent); background:var(--accent-sub); }

  /* HERO */
  .sp__hero { position:relative; padding-top:calc(clamp(4rem,8vw,7rem) + 4.5rem); padding-bottom:clamp(4rem,8vw,7rem); border-bottom:1px solid var(--border); overflow:hidden; }
  .bg-grid { position:absolute; inset:0; background-image:linear-gradient(var(--grid-color) 1px,transparent 1px),linear-gradient(90deg,var(--grid-color) 1px,transparent 1px); background-size:48px 48px; pointer-events:none; }
  .bg-glow { position:absolute; top:-200px; left:50%; transform:translateX(-50%); width:600px; height:600px; background:radial-gradient(circle,var(--accent-glow) 0%,transparent 70%); pointer-events:none; }
  .hero-layout { position:relative; display:grid; grid-template-columns:1fr; gap:4rem; align-items:center; }
  @media(min-width:992px){ .hero-layout { grid-template-columns:1.05fr .95fr; } }
  .hero-copy { max-width:580px; }
  .service-badge { display:inline-flex; align-items:center; gap:.5rem; background:var(--accent-sub); color:var(--accent); border:1px solid rgba(124,58,237,.2); padding:.4rem 1rem; border-radius:100px; font-size:.8125rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; margin-bottom:1.75rem; }
  .badge-dot { width:7px; height:7px; background:var(--accent); border-radius:50%; animation:pulse-dot 2.4s ease infinite; }
  @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.75)} }
  .hero-title { font-size:clamp(2.5rem,4.5vw,3.75rem); font-weight:800; line-height:1.08; letter-spacing:-.03em; color:var(--tx); margin-bottom:1.25rem; }
  .hero-title__highlight { color:var(--accent); }
  .hero-desc { font-size:1.125rem; line-height:1.65; color:var(--tx-muted); margin-bottom:2.25rem; }
  .hero-actions { display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:2.5rem; }
  .hero-stats { display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap; padding-top:2rem; border-top:1px solid var(--border); }
  .stat-item { display:flex; flex-direction:column; gap:.15rem; }
  .stat-num { font-size:1.375rem; font-weight:800; color:var(--accent); line-height:1; }
  .stat-label { font-size:.8125rem; color:var(--tx-dim); }
  .stat-divider { width:1px; height:36px; background:var(--border); }

  /* Store mock */
  .visual-frame { position:relative; filter:drop-shadow(var(--shadow-lg)); }
  .store-mock { background:var(--bg-card); border:1px solid var(--border); border-radius:16px; overflow:hidden; }
  .store-mock__topbar { display:flex; align-items:center; gap:1rem; padding:.875rem 1.25rem; border-bottom:1px solid var(--border); background:var(--bg-alt); }
  .store-mock__logo { width:80px; height:18px; background:var(--accent); border-radius:4px; opacity:.6; }
  .store-mock__nav { display:flex; gap:.5rem; flex:1; }
  .nav-item { width:40px; height:10px; background:var(--border); border-radius:3px; }
  .store-mock__cart { position:relative; color:var(--tx-muted); }
  .cart-count { position:absolute; top:-6px; right:-6px; width:16px; height:16px; background:var(--accent); color:#fff; font-size:.625rem; font-weight:700; border-radius:50%; display:flex; align-items:center; justify-content:center; }
  .store-mock__products { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; padding:1rem; }
  .product-card-mock { background:var(--bg-alt); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  /* Modificamos el contenedor original */
.product-img-mock { 
  height: 80px; 
  background: linear-gradient(135deg, var(--accent-sub), rgba(124,58,237,.15)); 
  position: relative;
  overflow: hidden; /* Evita que la imagen se salga de los bordes redondeados (si los tuviera) */
}

/* --- AÑADE ESTO PARA LA IMAGEN --- */
.product-img-mock img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Hace que la imagen llene el contenedor sin achaparrarse */
  display: block;
}
  .product-info-mock { padding:.625rem; display:flex; flex-direction:column; gap:.35rem; }
  .product-name-mock { height:8px; background:var(--border); border-radius:3px; width:75%; }
  .product-price-mock { height:10px; background:var(--accent); opacity:.4; border-radius:3px; width:40%; }
  .product-btn-mock { margin:.5rem .625rem .625rem; background:var(--accent); color:#fff; font-size:.625rem; font-weight:700; padding:.35rem .5rem; border-radius:6px; text-align:center; }

  .float-badge { position:absolute; display:inline-flex; align-items:center; gap:.5rem; background:var(--bg-glass); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border:1px solid var(--border); border-radius:100px; padding:.5rem 1rem; font-size:.8125rem; font-weight:600; color:var(--tx); box-shadow:var(--shadow-md); white-space:nowrap; }
  .float-badge svg { color:var(--accent); }
  .float-badge--tl { top:-14px; left:-12px; animation:float-y 5s ease-in-out infinite; }
  .float-badge--br { bottom:-14px; right:-12px; animation:float-y 5s ease-in-out infinite 2.5s; }
  @keyframes float-y { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

  /* AUDIENCE */
  .section-header { text-align:center; margin-bottom:3.5rem; }
  .section-eyebrow { font-size:.8125rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--accent); margin-bottom:.75rem; }
  .section-title { font-size:clamp(1.75rem,3vw,2.5rem); font-weight:800; letter-spacing:-.025em; color:var(--tx); margin-bottom:.75rem; }
  .section-sub { font-size:1.0625rem; color:var(--tx-muted); max-width:52ch; margin-inline:auto; }
  .audience-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:1.25rem; }
  .audience-card { background:var(--bg-card); border:1px solid var(--border); border-radius:16px; padding:1.75rem; box-shadow:var(--shadow-sm); transition:transform .3s,border-color .3s,box-shadow .3s; }
  .audience-card:hover { transform:translateY(-5px); border-color:var(--accent); box-shadow:var(--shadow-md),0 0 0 3px var(--accent-sub); }
  @media(prefers-color-scheme:dark){ .audience-card { background:var(--bg-glass); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); } }
  :global(.dark) .audience-card { background:var(--bg-glass); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); }
  .audience-icon { width:46px; height:46px; background:var(--accent-sub); color:var(--accent); display:flex; align-items:center; justify-content:center; border-radius:12px; margin-bottom:1.25rem; }
  .audience-role { font-size:1.125rem; font-weight:700; color:var(--tx); margin-bottom:.4rem; }
  .audience-focus { font-size:.9375rem; line-height:1.6; color:var(--tx-muted); margin:0; }

  /* BODY */
  .body-layout { display:grid; grid-template-columns:1fr; gap:4rem; align-items:start; }
  @media(min-width:1024px){ .body-layout { grid-template-columns:1fr 360px; } }
  .body-block { margin-bottom:4rem; }
  .body-eyebrow { font-size:.8125rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--accent); margin-bottom:.75rem; }
  .body-title { font-size:clamp(1.75rem,2.5vw,2.25rem); font-weight:800; letter-spacing:-.025em; color:var(--tx); margin-bottom:1.25rem; }
  .body-desc { font-size:1.0625rem; line-height:1.75; color:var(--tx-muted); max-width:68ch; }
  .features-heading { font-size:1.375rem; font-weight:700; color:var(--tx); margin-bottom:1.75rem; }
  .features-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.25rem; }
  .feature-card { background:var(--bg-alt); border:1px solid var(--border); border-radius:14px; padding:1.5rem; display:flex; flex-direction:column; gap:1rem; transition:border-color .25s,box-shadow .25s; }
  .feature-card:hover { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-sub); }
  .feature-lottie-slot { width:44px; height:44px; background:var(--accent-sub); border-radius:10px; display:flex; align-items:center; justify-content:center; }
  .feature-index { font-size:.875rem; font-weight:800; color:var(--accent); font-variant-numeric:tabular-nums; }
  .feature-title { font-size:1rem; font-weight:700; color:var(--tx); margin:0; }
  .feature-desc { font-size:.9rem; line-height:1.6; color:var(--tx-muted); margin:0; flex:1; }

  /* SIDEBAR */
  .body-sidebar { position:relative; }
  .pricing-card { background:var(--bg-card); border:1px solid var(--border); border-radius:20px; padding:2rem; position:sticky; top:110px; box-shadow:var(--shadow-lg); }
  @media(prefers-color-scheme:dark){ .pricing-card { background:var(--bg-glass); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); box-shadow:var(--shadow-lg),inset 0 1px 0 rgba(255,255,255,.05); } }
  :global(.dark) .pricing-card { background:var(--bg-glass); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); box-shadow:var(--shadow-lg),inset 0 1px 0 rgba(255,255,255,.05); }
  .pricing-card__header { padding-bottom:1.25rem; margin-bottom:1.25rem; border-bottom:1px solid var(--border); }
  .pricing-card__eyebrow { font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--accent); margin-bottom:.25rem; }
  .pricing-card__title { font-size:1.25rem; font-weight:700; color:var(--tx); margin:0; }
  .pricing-meta { margin-bottom:1.5rem; display:flex; flex-direction:column; gap:0; }
  .pricing-meta__row { display:flex; justify-content:space-between; align-items:center; padding-block:.9rem; border-bottom:1px dashed var(--border); }
  .pricing-meta__row:last-child { border-bottom:none; }
