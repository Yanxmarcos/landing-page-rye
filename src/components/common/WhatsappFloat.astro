---
import { contactConfig } from '../../data/contact';
const { whatsapp } = contactConfig;
---

<a
  href={whatsapp.url}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Contactar por WhatsApp"
  id="wa-float"
>
  <!-- Tooltip -->
  <span class="wa-float__tooltip" aria-hidden="true">
    ¿Hablamos? 👋
  </span>

  <!-- Ícono WhatsApp SVG oficial -->
  <svg
    class="wa-float__icon"
    viewBox="0 0 24 24"
    fill="currentColor"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>

  <!-- Pulso animado -->
  <span class="wa-float__pulse" aria-hidden="true"></span>
</a>

<script>
  // Mostrar tooltip una vez al entrar la página
  const btn = document.getElementById('wa-float');
  if (btn) {
    setTimeout(() => btn.classList.add('wa-float--show-tip'), 2500);
    setTimeout(() => btn.classList.remove('wa-float--show-tip'), 6000);
    btn.addEventListener('mouseenter', () => btn.classList.add('wa-float--show-tip'));
    btn.addEventListener('mouseleave', () => btn.classList.remove('wa-float--show-tip'));
  }
</script>

<style>
  .wa-float {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 99;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s;
    box-shadow: 0 4px 16px rgba(37,211,102,0.4);
  }

  .wa-float:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(37,211,102,0.55);
  }

  /* Ícono */
  .wa-float__icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  /* Tooltip */
  .wa-float__tooltip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: var(--color-surface, #0B1420);
    color: var(--color-text, #F0F0F0);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid rgba(37,211,102,0.25);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s, transform 0.25s;
  }

  /* Flecha del tooltip */
  .wa-float__tooltip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border: 5px solid transparent;
    border-left-color: rgba(37,211,102,0.25);
  }

  .wa-float--show-tip .wa-float__tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Pulso de atención */
  .wa-float__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25D366;
    animation: wa-pulse 2.5s ease-out infinite;
    z-index: 0;
  }

  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.6; }
    70%  { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .wa-float__pulse { animation: none; }
    .wa-float { transition: none; }
  }
</style>