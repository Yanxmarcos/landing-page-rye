---
import { contactConfig } from '../../data/contact';
import { services } from '../../data/services';

const { whatsapp, email, socials } = contactConfig;

const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    heading: 'Servicios',
    links: services.map(service => ({
      label: service.title,
      href: `/servicios/${service.slug}`,
    })),
  },
  {
    heading: 'Empresa',
    links: [
      { label: 'Inicio',       href: '/#inicio'    },
      { label: 'Proceso',      href: '/#proceso'   },
      { label: 'Nosotros',     href: '/#nosotros'  },
      { label: 'Reseñas',      href: '/#resenas'   },
      { label: 'Contacto',     href: '/#contacto'  },
    ],
  },
];

const socialIcons: Record<string, string> = {
  tiktok:    `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>`,
  facebook:  `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  instagram: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`,
};
---

<footer class="footer" id="footer">

  <!-- Franja superior CTA -->
  <div class="footer__cta-strip">
    <div class="container footer__cta-inner">
      <div class="footer__cta-text">
        <h2 class="footer__cta-title">¿Tienes un proyecto en mente?</h2>
        <p class="footer__cta-sub">Hablemos hoy — sin compromiso.</p>
      </div>
      <div class="footer__cta-actions">
        <a href={whatsapp.url} target="_blank" rel="noopener noreferrer"
           class="footer__cta-btn footer__cta-btn--wa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <a href={`mailto:${email.address}`} class="footer__cta-btn footer__cta-btn--mail">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="3"/>
            <path d="M2 7l10 7 10-7"/>
          </svg>
          Escribir correo
        </a>
      </div>
    </div>
  </div>

  <!-- Cuerpo del footer -->
  <div class="footer__body">
    <div class="container footer__body-inner">

      <!-- Columna: marca -->
      <div class="footer__brand">
        <!-- Logo: imagen si está disponible, wordmark si no -->
        <a href="/" class="footer__logo" aria-label="RYE WEB — inicio">
          <img
            src="/descarga.png"
            alt="RYE WEB"
            class="footer__logo-img"
            width="130"
            height="44"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <!-- Fallback wordmark si no hay imagen -->
          <span class="footer__logo-fallback" style="display:none;">
            RYE <em>WEB</em>
          </span>
        </a>

        <p class="footer__tagline">
          Conecta. Crea. Acelera.
        </p>
        <p class="footer__brand-desc">
          Desarrollamos sitios web que convierten visitantes en clientes reales.
          Estrategia, diseño y código — todo en un solo equipo.
        </p>

        <!-- Redes sociales -->
        <div class="footer__socials">
          {socials.map(social => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social"
              aria-label={social.label}
              set:html={socialIcons[social.id] ?? ''}
            />
          ))}
        </div>
      </div>

      <!-- Columnas: links -->
      {footerLinks.map(group => (
        <div class="footer__col">
          <h3 class="footer__col-heading">{group.heading}</h3>
          <ul class="footer__col-links" role="list">
            {group.links.map(link => (
              <li>
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Columna: contacto -->
      <div class="footer__col">
        <h3 class="footer__col-heading">Contacto</h3>
        <ul class="footer__col-links footer__contact-list" role="list">
          <li class="footer__contact-item">
            <span class="footer__contact-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </span>
            <a href={whatsapp.url} target="_blank" rel="noopener noreferrer"
               class="footer__link">{whatsapp.display}</a>
          </li>
          <li class="footer__contact-item">
            <span class="footer__contact-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="3"/>
                <path d="M2 7l10 7 10-7"/>
              </svg>
            </span>
            <a href={`mailto:${email.address}`} class="footer__link">
              {email.address}
            </a>
          </li>
          <li class="footer__contact-item">
            <span class="footer__contact-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </span>
            <span class="footer__contact-text">
              Lun – Sab · 24/7 (Perú)
            </span>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Barra inferior: copyright -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copy">
        © {currentYear} RYE WEB. Todos los derechos reservados.
      </p>
      <p class="footer__copy footer__copy--right">
        Hecho por RYE WEB, Perú
      </p>
    </div>
  </div>

</footer>

<style>
  .footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  /* =====================================================
     FRANJA CTA SUPERIOR
  ===================================================== */
  .footer__cta-strip {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 2.5rem 0;
  }

  .footer__cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer__cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .footer__cta-sub {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }

  .footer__cta-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .footer__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 700;
    font-family: var(--font-body);
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    border: 1px solid transparent;
  }

  .footer__cta-btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .footer__cta-btn--wa {
    background: #25D366;
    color: #fff;
  }

  .footer__cta-btn--mail {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border-solid);
  }

  .footer__cta-btn--mail:hover {
    border-color: var(--color-border-hover);
    background: var(--color-surface-2);
  }

  /* =====================================================
     CUERPO DEL FOOTER
  ===================================================== */
  .footer__body {
    padding: 3.5rem 0 2.5rem;
  }

  .footer__body-inner {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  /* --- Marca ------------------------------------------- */
  .footer__logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: 0.875rem;
    text-decoration: none;
  }

  .footer__logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .footer__logo-fallback {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    align-items: center;
    gap: 4px;
  }

  .footer__logo-fallback em {
    font-style: normal;
    color: var(--color-blue);
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
    line-height: 1;
  }

  .footer__brand-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 32ch;
  }

  /* Redes sociales */
  .footer__socials {
    display: flex;
    gap: 8px;
  }

  .footer__social {
    width: 36px; height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .footer__social:hover {
    color: var(--color-blue);
    border-color: var(--color-border-hover);
    background: var(--color-surface-3);
    transform: translateY(-2px);
  }

  /* --- Columnas de links -------------------------------- */
  .footer__col-heading {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    /* Override del reset global de h3 */
    font-size: 0.72rem;
    line-height: 1;
  }

  .footer__col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s, padding-left 0.2s;
    display: inline-block;
  }

  .footer__link:hover {
    color: var(--color-text);
    padding-left: 4px;
  }

  /* --- Contacto ----------------------------------------- */
  .footer__contact-list { gap: 0.875rem; }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }

  .footer__contact-icon {
    width: 28px; height: 28px;
    border-radius: 7px;
    background: rgba(30,159,232,0.08);
    border: 1px solid rgba(30,159,232,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-blue);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .footer__contact-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    padding-top: 5px;
  }

  /* =====================================================
     BARRA INFERIOR
  ===================================================== */
  .footer__bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 0;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: 0.78rem;
    color: var(--color-text-dim);
    font-family: var(--font-body);
    line-height: 1;
  }

  /* --- Responsivo --------------------------------------- */
  @media (max-width: 960px) {
    .footer__body-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__brand-desc { max-width: 100%; }
  }

  @media (max-width: 580px) {
   .footer__cta-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .footer__cta-actions {
      justify-content: center;
      width: 100%;
    }

    /* --- 2. Cuerpo del Footer: Grid de 2 columnas --- */
    .footer__body-inner {
      /* Creamos 2 columnas para que Servicios y Empresa queden lado a lado */
      grid-template-columns: 1fr 1fr; 
      gap: 2rem;
    }

    /* Marca / Logo: Ocupa las 2 columnas y va centrada */
    .footer__brand { 
      grid-column: 1 / -1; /* Obliga a ocupar todo el ancho disponible */
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__socials {
      justify-content: center;
    }

    /* Servicios y Empresa: Se alinean a la izquierda ("justificados") dentro de sus columnas */
    .footer__col:nth-child(2),
    .footer__col:nth-child(3) {
      text-align: left;
    }

    /* Contacto: Ocupa las 2 columnas y se centra */
    .footer__col:last-child {
      grid-column: 1 / -1;
      text-align: center; /* Centra el título "Contacto" */
    }

    /* El truco de Contacto: Centra el bloque entero, pero alinea el contenido a la izquierda */
    .footer__contact-list {
      width: fit-content; /* Se adapta al tamaño del texto más largo */
      margin: 0 auto;     /* Centra el bloque en la pantalla */
      display: flex;
      flex-direction: column;
      align-items: flex-start; /* Mantiene los íconos rectos/justificados */
    }

    .footer__contact-item {
      justify-content: flex-start; /* Asegura que ícono y texto empiecen desde la izquierda */
      text-align: left;
    }

    /* Evitar que el texto tiemble en hover en móvil */
    .footer__link:hover {
      padding-left: 0;
    }

    /* --- 3. Barra Inferior: Centrada --- */
    .footer__bottom-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__copy--right { 
      order: -1; 
    }.footer__cta-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .footer__cta-actions {
      justify-content: center;
      width: 100%;
    }

    /* --- 2. Cuerpo del Footer: Grid de 2 columnas --- */
    .footer__body-inner {
      /* Creamos 2 columnas para que Servicios y Empresa queden lado a lado */
      grid-template-columns: 1fr 1fr; 
      gap: 2rem 1rem;
    }

    /* Marca / Logo: Ocupa las 2 columnas y va centrada */
    .footer__brand { 
      grid-column: 1 / -1; /* Obliga a ocupar todo el ancho disponible */
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__socials {
      justify-content: center;
    }

    /* Servicios y Empresa: Se alinean a la izquierda ("justificados") dentro de sus columnas */
   .footer__col:nth-child(2),
    .footer__col:nth-child(3) {
      display: flex;
      flex-direction: column;
      align-items: center; /* Centra las listas <ul> */
      text-align: center;  /* Centra los títulos <h3> */
    }
    .footer__link:hover {
      padding-left: 0;
    }
    /* Contacto: Ocupa las 2 columnas y se centra */
    .footer__col:last-child {
      grid-column: 1 / -1;
      text-align: center; 
      margin-top: 1rem;/* Centra el título "Contacto" */
    }

    /* El truco de Contacto: Centra el bloque entero, pero alinea el contenido a la izquierda */
    .footer__contact-list {
      width: fit-content; /* Se adapta al tamaño del texto más largo */
      margin: 0 auto;     /* Centra el bloque en la pantalla */
      display: flex;
      flex-direction: column;
      align-items: flex-start; /* Mantiene los íconos rectos/justificados */
    }

    .footer__contact-item {
      justify-content: flex-start; /* Asegura que ícono y texto empiecen desde la izquierda */
      text-align: left;
    }

    /* Evitar que el texto tiemble en hover en móvil */
    .footer__link:hover {
      padding-left: 0;
    }

    /* --- 3. Barra Inferior: Centrada --- */
    .footer__bottom-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer__copy--right { 
      order: -1; 
    }
</style>
