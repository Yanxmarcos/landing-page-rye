---
import { services } from '../../data/services';

// Categorización de servicios para el mega-menú
const serviceCategories = {
  'Desarrollo Web': services.filter(s => ['Landing Page', 'E-commerce', 'Corporativo'].includes(s.tag)),
  'Soluciones a Medida': services.filter(s => ['E-learning', 'Sistema'].includes(s.tag)),
  'Marketing Digital': services.filter(s => ['SEO'].includes(s.tag)),
};

const homeSection = (id: string) => `${Astro.url.pathname === '/' ? '' : '/'}#${id}`;
const navLinks = [
  { label: 'Servicios', href: homeSection('servicios') },
  { label: 'Proceso',   href: homeSection('proceso') },
  { label: 'Nosotros',  href: homeSection('nosotros') },
  { label: 'Reseñas',   href: homeSection('resenas') },
  { label: 'Contacto',  href: homeSection('contacto') },
];
---

<header class="navbar" id="navbar">
  <nav class="navbar__inner container">

    <!-- Logo -->
    <!-- Logo: Imagen PNG + Texto RYE WEB al lado -->
<a href="/" class="navbar__logo" aria-label="RYE WEB — inicio">
  <img
    src="/descarga.png"
    alt="RYE WEB"
    class="navbar__logo-img"
    width="52"
    height="52"
  />
  <span class="navbar__logo-text">
    RYE <em>WEB</em>
  </span>
</a>

    <!-- Links desktop -->
    <ul class="navbar__links" id="nav-menu" role="list">
      {navLinks.map(link => {
        if (link.label === 'Servicios') {
          return (
            <li class="navbar__dropdown-container">
              <a href={link.href} class="navbar__link has-dropdown">{link.label}</a>
              <div class="navbar__dropdown">
                <div class="navbar__dropdown-grid">
                  {Object.entries(serviceCategories).map(([category, servicesInCategory]) => (
                    <div class="navbar__dropdown-col">
                      <h3 class="navbar__dropdown-heading">{category}</h3>
                      <ul role="list">
                        {servicesInCategory.map(service => (
                          <li>
                            <a href={`/servicios/${service.slug}`} class="navbar__dropdown-link">
                              {service.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          );
        }
        return (
          <li>
            <a href={link.href} class="navbar__link">
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Controles: toggle + CTA + hamburger -->
    <div class="navbar__controls">

      <!-- Toggle claro/oscuro -->
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        role="switch"
        aria-label="Modo claro"
        aria-checked="false"
        title="Modo claro"
      >
        <!-- Ícono luna (modo oscuro activo) -->
        <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M14 10.5A6.5 6.5 0 015.5 2a6.5 6.5 0 108.5 8.5z"
                  fill="currentColor"/>
          </svg>
        </span>
        <!-- Ícono sol (modo claro activo) -->
        <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="3.5" fill="currentColor"/>
            <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.54 11.54l1.41 1.41M3.05 12.95l1.42-1.41M11.54 4.46l1.41-1.41"
                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="theme-toggle__track" aria-hidden="true">
          <span class="theme-toggle__thumb"></span>
        </span>
      </button>

      <!-- CTA desktop -->
      <a href={homeSection('contacto')} class="navbar__cta">Cotizar gratis</a>

      <!-- Hamburger móvil -->
      <button
        class="navbar__hamburger"
        id="hamburger"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </nav>

  <!-- Menú móvil -->
  <div class="navbar__mobile-menu" id="mobile-menu" inert>
    <div class="navbar__mobile-inner">
      {navLinks.map(link => (
        <a href={link.href} class="navbar__mobile-link">
          {link.label}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 8h8M9 5l3 3-3 3"
                  stroke="currentColor" stroke-width="1.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      ))}
      <a href={homeSection('contacto')} class="navbar__mobile-cta">Cotizar gratis</a>
    </div>
  </div>
</header>

<script>
  /* ---- Toggle de tema ---------------------------------- */
  const toggleBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  toggleBtn?.setAttribute('aria-checked', String(root.dataset.theme === 'light'));

  toggleBtn?.addEventListener('click', () => {
    const isLight = root.dataset.theme !== 'light';
    const theme = isLight ? 'light' : 'dark';
    root.dataset.theme = theme;
    toggleBtn.setAttribute('aria-checked', String(isLight));
    try {
      localStorage.setItem('rye-theme', theme);
    } catch {
      // El cambio visual funciona aunque el navegador bloquee el almacenamiento.
    }
  });

  /* ---- Scroll effect ----------------------------------- */
  const navbar = document.getElementById('navbar')!;
  const onScroll = () => {
    navbar.classList.toggle('navbar--scrolled', window.scrollY > 40);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ---- Hamburger --------------------------------------- */
  const hamburger  = document.getElementById('hamburger')!;
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu')!;

  function setMobileMenu(open: boolean) {
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    hamburger.classList.toggle('navbar__hamburger--open', open);
    mobileMenu.classList.toggle('navbar__mobile-menu--open', open);
    mobileMenu.inert = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  }

  hamburger.addEventListener('click', () => {
    setMobileMenu(mobileMenu.inert);
  });

  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !mobileMenu.inert) {
      setMobileMenu(false);
      hamburger.focus();
    }
  });

  window.matchMedia('(max-width: 1024px)').addEventListener('change', event => {
    if (!event.matches && !mobileMenu.inert) setMobileMenu(false);
  });

  /* ---- Active link por sección ------------------------- */
  const sections = document.querySelectorAll('section[id]');
  const links    = document.querySelectorAll('.navbar__link');

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        links.forEach(link => {
          link.classList.toggle(
            'navbar__link--active',
            link.getAttribute('href') === `#${entry.target.id}`
          );
        });
      }
    });
  }, { threshold: 0.4 });

  sections.forEach(s => observer.observe(s));
</script>

<style>
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 1rem 0;
    transition: background 0.3s ease, padding 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  .navbar--scrolled {
    background: var(--color-nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 0.625rem 0;
    border-color: var(--color-nav-border);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* --- Logo -------------------------------------------- */
.navbar__logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  text-decoration: none;
  gap: 10px;                    /* espacio entre la imagen y el texto */
}

.navbar__logo-img {
  height: 42px;
  width: auto;
  object-fit: contain;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.1));
}

.navbar__logo:hover .navbar__logo-img {
  transform: scale(1.05);
}

.navbar__logo-text {
  font-family: var(--font-display);
  font-size: 1.65rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--color-text);
  white-space: nowrap;
}

.navbar__logo-text em {
  font-style: normal;
  color: var(--color-blue);
}

  /* --- Links ------------------------------------------- */
  .navbar__links {
    display: flex;
    list-style: none;
    gap: 1.75rem;
    margin-left: auto;
  }

  .navbar__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.22s;
  }

  /* === TRIÁNGULO / FLECHA DEL DROPDOWN === */
.navbar__link.has-dropdown {
  display: inline-flex;
  align-items: center;
  gap: 4px;                    /* espacio entre texto y flecha */
}

.navbar__link.has-dropdown::after {
  content: '▼';
  font-size: 0.65em;
  line-height: 1;
  margin-top: -2px;            /* ajuste fino vertical */
  transition: transform 0.25s ease;
}

/* Efecto al hacer hover (la flecha gira hacia arriba) */
.navbar__link.has-dropdown:hover::after {
  transform: rotate(180deg);
}

  .navbar__link::after {
    content: '';
    position: absolute;
    bottom: -2px; left: 0;
    width: 0; height: 1.5px;
    background: var(--color-blue);
    border-radius: 2px;
    transition: width 0.25s ease;
  }

  .navbar__link:hover,
  .navbar__link--active { color: var(--color-text); }

  .navbar__link:hover::after,
  .navbar__link--active::after { width: 100%; }

  /* --- Dropdown de Servicios --------------------------- */
  .navbar__dropdown-container {
    position: relative;
  }

  .navbar__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    width: max-content;
    max-width: 600px;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    z-index: 110;
  }

  :global(html[data-theme="light"]) .navbar__dropdown {
    box-shadow: 0 10px 25px rgba(10,22,40,0.08), 0 4px 10px rgba(10,22,40,0.04);
  }

  .navbar__dropdown-container:hover .navbar__dropdown,
  .navbar__dropdown-container:focus-within .navbar__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .navbar__dropdown-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .navbar__dropdown-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .navbar__dropdown-heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 1rem;
    /* Override de h3 global */
    line-height: 1;
  }

  .navbar__dropdown-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    display: block;
    padding: 4px 0;
    transition: color 0.2s, padding-left 0.2s;
  }

  .navbar__dropdown-link:hover {
    color: var(--color-text);
    padding-left: 6px;
  }

  /* --- Controles (toggle + CTA + hamburger) ------------ */
  .navbar__controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* ====================================================
     TOGGLE CLARO / OSCURO
  ==================================================== */
  .theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 5px 10px 5px 8px;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--color-border-hover);
    color: var(--color-text);
  }

  /* Muestra luna en oscuro, sol en claro */
  .theme-toggle__icon { display: flex; align-items: center; }

  .theme-toggle__icon--light { display: none; }
  .theme-toggle__icon--dark  { display: flex; }

  :global(html[data-theme="light"]) .theme-toggle__icon--light { display: flex; }
  :global(html[data-theme="light"]) .theme-toggle__icon--dark  { display: none; }

  /* Track del toggle */
  .theme-toggle__track {
    width: 34px; height: 18px;
    border-radius: 100px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    position: relative;
    flex-shrink: 0;
    transition: background 0.3s;
  }

  :global(html[data-theme="light"]) .theme-toggle__track {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  /* Thumb */
  .theme-toggle__thumb {
    position: absolute;
    top: 2px; left: 2px;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--color-text-muted);
    transition: transform 0.3s var(--ease-out), background 0.3s;
  }

  :global(html[data-theme="light"]) .theme-toggle__thumb {
    transform: translateX(16px);
    background: #fff;
  }

  /* --- CTA --------------------------------------------- */
  .navbar__cta {
    background: var(--color-blue);
    color: #fff;
    border-radius: var(--radius-full);
    padding: 0.5rem 1.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.2s;
  }

  .navbar__cta:hover { opacity: 0.88; transform: translateY(-1px); }

  /* --- Hamburger --------------------------------------- */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .navbar__hamburger span {
    display: block;
    width: 22px; height: 1.5px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }

  .navbar__hamburger--open span:nth-child(1) { transform: rotate(45deg) translate(4.5px, 4.5px); }
  .navbar__hamburger--open span:nth-child(2) { opacity: 0; transform: translateX(-8px); }
  .navbar__hamburger--open span:nth-child(3) { transform: rotate(-45deg) translate(4.5px, -4.5px); }

  /* --- Menú móvil -------------------------------------- */
  .navbar__mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    background: var(--color-nav-bg);
    backdrop-filter: blur(16px);
    border-top: 0px solid var(--color-border);
    transition: max-height 0.35s ease;
  }

  .navbar__mobile-menu--open { max-height: 400px; }

  .navbar__mobile-inner {
    padding: 1.5rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .navbar__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .navbar__mobile-link:hover { color: var(--color-text); }

  .navbar__mobile-cta {
    display: block;
    background: var(--color-blue);
    color: #fff;
    text-align: center;
    border-radius: var(--radius-full);
    padding: 0.875rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    margin-top: 0.5rem;
    transition: opacity 0.2s;
  }

  .navbar__mobile-cta:hover { opacity: 0.88; }

  /* --- Responsive -------------------------------------- */
  @media (max-width: 1024px) {
    .navbar__links,
    .navbar__cta { display: none; }

    .navbar__hamburger { display: flex; }
    .navbar__mobile-menu { display: block; }
    .navbar__controls { margin-left: auto; }
    .navbar__inner { gap: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__thumb { transition: none; }
  }
</style>
