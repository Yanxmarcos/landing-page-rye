---
import { projects } from '../../data/portfolio';
import type { PortfolioCategory } from '../../data/portfolio';

// Categorías únicas para los filtros
const categories = [...new Set(projects.map(p => p.category))];

// Etiquetas legibles para los filtros
const categoryLabels: Record<PortfolioCategory, string> = {
  Landing:     'Landing Page',
  Ecommerce:   'E-commerce',
  Corporativo: 'Corporativo',
  Elearning:   'E-learning',
  Sistema:     'Sistema',
};
---

<section class="portfolio section" id="portafolio">
  <div class="container">

    <!-- Header -->
    <div class="portfolio__header">
      <span class="portfolio__eyebrow">Casos de éxito</span>
      <h2 class="portfolio__title">
        Proyectos que hablan<br />por sí solos
      </h2>
      <p class="portfolio__subtitle">
        Cada proyecto entregado con estrategia, diseño cuidado y resultados medibles.
      </p>
    </div>

    {projects.length === 0 ? (
      <!-- Estado vacío: mientras no hay proyectos reales -->
      <div class="portfolio__empty">
        <div class="portfolio__empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
            <rect x="4" y="8" width="32" height="26" rx="5"
                  stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 16h32" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="12" r="1.5" fill="currentColor"/>
            <circle cx="14" cy="12" r="1.5" fill="currentColor"/>
            <circle cx="19" cy="12" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <p class="portfolio__empty-title">Proyectos en camino</p>
        <p class="portfolio__empty-desc">
          Estamos finalizando los primeros casos de estudio.<br />
          Mientras tanto, cuéntanos tu proyecto.
        </p>
        <a href="#contacto" class="portfolio__empty-cta">
          Cotizar mi proyecto
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
            <path d="M2 6.5h9M7.5 3l3.5 3.5L7.5 10"
                  stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    ) : (
      <>
        <!-- Filtros -->
        <div class="portfolio__filters" role="group" aria-label="Filtrar proyectos">
          <button
            class="filter-btn filter-btn--active"
            data-filter="all"
            aria-pressed="true"
          >
            Todos
          </button>
          {categories.map(cat => (
            <button
              class="filter-btn"
              data-filter={cat}
              aria-pressed="false"
            >
              {categoryLabels[cat]}
            </button>
          ))}
        </div>

        <!-- Grid masonry -->
        <div class="portfolio__grid" id="portfolio-grid">
          {projects.map((project, i) => (
            <article
              class:list={[
                'pf-card',
                project.size === 'tall' && 'pf-card--tall',
                project.size === 'wide' && 'pf-card--wide',
              ]}
              data-category={project.category}
              data-index={i}
              role="button"
              tabindex="0"
              aria-label={`Ver detalle de ${project.title}`}
            >
              <!-- Visual (imagen o placeholder CSS) -->
              <div class="pf-card__visual">
                <div class="pf-card__bg" style={`--accent:${project.accent}`}></div>

                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="pf-card__img"
                    loading="lazy"
                  />
                ) : (
                  <!-- Placeholder: mini browser mockup generado con CSS -->
                  <div class="pf-card__mock" aria-hidden="true">
                    <div class="mock-browser">
                      <div class="mock-browser__bar">
                        <span class="mock-dot mock-dot--r"></span>
                        <span class="mock-dot mock-dot--y"></span>
                        <span class="mock-dot mock-dot--g"></span>
                      </div>
                      <div class="mock-browser__content">
                        <span class="mock-line mock-line--accent" style={`background:${project.accent.replace('0.08','0.5').replace('0.1','0.5')}`}></span>
                        <span class="mock-line" style="width:80%"></span>
                        {project.size === 'tall' && (
                          <>
                            <span class="mock-line mock-line--block"></span>
                            <span class="mock-line" style="width:65%"></span>
                            <span class="mock-line" style="width:45%"></span>
                          </>
                        )}
                        <span class="mock-line" style="width:55%"></span>
                      </div>
                    </div>
                  </div>
                )}

                <!-- Número decorativo -->
                <span class="pf-card__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>

              <!-- Overlay con CTAs -->
              <div class="pf-card__overlay" aria-hidden="true">
                <div class="pf-card__overlay-content">
                  <span class="pf-card__cat">{project.categoryLabel}</span>
                  <h3 class="pf-card__title">{project.title}</h3>
                  <p class="pf-card__result">{project.resultPreview}</p>
                  <div class="pf-card__btns">
                    {project.url && (
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="pf-btn pf-btn--primary"
                        aria-label={`Ver ${project.title} en vivo`}
                      >
                        Ver en vivo →
                      </a>
                    )}
                    <button class="pf-btn pf-btn--ghost" data-open={i}>
                      Ver detalle
                    </button>
                  </div>
                </div>
              </div>

            </article>
          ))}
        </div>

        <!-- CTA final -->
        <div class="portfolio__cta">
          <a href="#contacto" class="btn btn--primary btn--lg">
            Quiero un proyecto así
          </a>
        </div>
      </>
    )}

  </div>
</section>

<!-- ======================================================
     MODAL DE DETALLE
====================================================== -->
<div
  class="pf-modal"
  id="pf-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="pf-modal-title"
>
  <div class="pf-modal__backdrop" id="pf-modal-backdrop"></div>

  <div class="pf-modal__panel">
    <button class="pf-modal__close" id="pf-modal-close" aria-label="Cerrar">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 1l12 12M13 1L1 13"
              stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Visual del modal -->
    <div class="pf-modal__visual" id="pf-modal-visual">
      <div class="pf-modal__visual-bg" id="pf-modal-bg"></div>
      <div class="pf-modal__visual-browser" aria-hidden="true">
        <div class="pf-modal__visual-bar">
          <span class="mock-dot mock-dot--r"></span>
          <span class="mock-dot mock-dot--y"></span>
          <span class="mock-dot mock-dot--g"></span>
        </div>
        <div class="pf-modal__visual-content">
          <span class="mock-line mock-line--accent" id="pf-modal-accent-line"></span>
          <span class="mock-line" style="width:82%"></span>
          <span class="mock-line mock-line--block"></span>
          <span class="mock-line" style="width:60%"></span>
        </div>
      </div>
    </div>

    <!-- Cuerpo del modal -->
    <div class="pf-modal__body">
      <span class="pf-modal__cat"  id="pf-modal-cat"></span>
      <h2  class="pf-modal__title" id="pf-modal-title"></h2>
      <p   class="pf-modal__desc"  id="pf-modal-desc"></p>
      <div class="pf-modal__tags"  id="pf-modal-tags"></div>
      <div class="pf-modal__results" id="pf-modal-results"></div>
      <div class="pf-modal__actions">
        <a
          class="pf-modal-btn pf-modal-btn--primary"
          id="pf-modal-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver sitio en vivo →
        </a>
        <a
          class="pf-modal-btn pf-modal-btn--ghost"
          href="#contacto"
          id="pf-modal-similar"
        >
          Quiero algo similar
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Datos serializados para el script -->
<script id="pf-data" type="application/json" set:html={JSON.stringify(projects)} />

<script>
  import type { PortfolioProject } from '../../data/portfolio';

  const allProjects: PortfolioProject[] = JSON.parse(
    document.getElementById('pf-data')?.textContent ?? '[]'
  );

  /* ---- Modal ------------------------------------------ */
  const modal    = document.getElementById('pf-modal')!;
  const backdrop = document.getElementById('pf-modal-backdrop')!;
  const closeBtn = document.getElementById('pf-modal-close')!;

  function openModal(idx: number) {
    const p = allProjects[idx];
    if (!p) return;

    // Visual
    const bg = document.getElementById('pf-modal-bg')!;
    bg.style.background = `radial-gradient(ellipse 90% 90% at 50% 0%, ${p.accent}, var(--color-surface-3))`;

    const accentLine = document.getElementById('pf-modal-accent-line') as HTMLElement;
    accentLine.style.background = p.accent.replace(/[\d.]+\)$/, '0.55)');

    // Si tiene imagen, mostrarla en lugar del browser mockup
    const visualEl = document.getElementById('pf-modal-visual')!;
    const existingImg = visualEl.querySelector<HTMLImageElement>('.pf-modal__img');
    if (existingImg) existingImg.remove();

    if (p.image) {
      const img = document.createElement('img');
      img.src = p.image;
      img.alt = p.title;
      img.className = 'pf-modal__img';
      visualEl.appendChild(img);
      visualEl.querySelector<HTMLElement>('.pf-modal__visual-browser')!.style.display = 'none';
    } else {
      const browser = visualEl.querySelector<HTMLElement>('.pf-modal__visual-browser')!;
      browser.style.display = '';
    }

    // Texto
    document.getElementById('pf-modal-cat')!.textContent   = p.categoryLabel;
    document.getElementById('pf-modal-title')!.textContent = p.title;
    document.getElementById('pf-modal-desc')!.textContent  = p.description;

    // Tags
    document.getElementById('pf-modal-tags')!.innerHTML = p.tags
      .map(t => `<span class="pf-modal__tag">${t}</span>`)
      .join('');

    // Resultados
    document.getElementById('pf-modal-results')!.innerHTML = p.results
      .map(r => `
        <div class="pf-result">
          <span class="pf-result__val">${r.value}</span>
          <span class="pf-result__lbl">${r.label}</span>
        </div>`)
      .join('');

    // Link externo
    const link = document.getElementById('pf-modal-link') as HTMLAnchorElement;
    if (p.url) {
      link.href = p.url;
      link.style.display = '';
    } else {
      link.style.display = 'none';
    }

    // Abrir
    modal.setAttribute('aria-hidden', 'false');
    modal.classList.add('pf-modal--open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    modal.classList.remove('pf-modal--open');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // Cerrar y scroll a contacto desde "Quiero algo similar"
  document.getElementById('pf-modal-similar')?.addEventListener('click', closeModal);

  /* ---- Cards ------------------------------------------ */
  document.querySelectorAll<HTMLElement>('.pf-card').forEach(card => {
    const idx = parseInt(card.dataset.index ?? '0');

    // Click en botón "Ver detalle"
    card.querySelector<HTMLButtonElement>('[data-open]')?.addEventListener('click', e => {
      e.stopPropagation();
      openModal(idx);
    });

    // Teclado
    card.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(idx); }
    });
  });

  /* ---- Filtros ---------------------------------------- */
  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('filter-btn--active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('filter-btn--active');
      btn.setAttribute('aria-pressed', 'true');

      document.querySelectorAll<HTMLElement>('.pf-card').forEach(card => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('pf-card--hidden', !match);
      });
    });
  });
</script>

<style>
  .portfolio {
    background: var(--color-surface);
  }

  /* --- Header ------------------------------------------- */
  .portfolio__header {
    max-width: 580px;
    margin-bottom: 2.5rem;
  }

  .portfolio__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
  }

  .portfolio__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .portfolio__subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* --- Estado vacío ------------------------------------- */
  .portfolio__empty {
    text-align: center;
    padding: 5rem 2rem;
    border: 1px dashed rgba(30,159,232,0.2);
    border-radius: var(--radius-xl);
    background: var(--color-surface-2);
  }

  .portfolio__empty-icon {
    color: var(--color-text-muted);
    opacity: 0.3;
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .portfolio__empty-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.625rem;
  }

  .portfolio__empty-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .portfolio__empty-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--color-blue);
    color: #fff;
    border-radius: var(--radius-full);
    padding: 0.875rem 2rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .portfolio__empty-cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  /* --- Filtros ------------------------------------------ */
  .portfolio__filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .filter-btn {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover {
    border-color: rgba(30,159,232,0.3);
    color: var(--color-text);
  }

  .filter-btn--active {
    background: rgba(30,159,232,0.1);
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  /* --- Grid masonry ------------------------------------- */
  .portfolio__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 210px;
    gap: 12px;
    margin-bottom: 3rem;
  }

  /* ======================================================
     CARD
  ====================================================== */
  .pf-card {
    position: relative;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    outline: none;
    transition:
      transform 0.32s var(--ease-out),
      border-color 0.28s,
      opacity 0.3s;
  }

  .pf-card--tall { grid-row: span 2; }
  .pf-card--wide { grid-column: span 2; }

  .pf-card--hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.97);
  }

  .pf-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-border-hover);
  }

  .pf-card:focus-visible {
    box-shadow: 0 0 0 3px rgba(30,159,232,0.35);
  }

  /* Borde top animado */
  .pf-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-blue), var(--color-violet));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.32s var(--ease-out);
    z-index: 2;
  }

  .pf-card:hover::before { transform: scaleX(1); }

  /* Visual container */
  .pf-card__visual {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Fondo con patrón por categoría */
  .pf-card__bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--accent, rgba(30,159,232,0.05)) 1px, transparent 1px),
      linear-gradient(90deg, var(--accent, rgba(30,159,232,0.05)) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* Imagen real */
  .pf-card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease-out);
    position: relative;
    z-index: 1;
  }

  .pf-card:hover .pf-card__img { transform: scale(1.05); }

  /* Mock browser placeholder */
  .pf-card__mock {
    position: relative;
    z-index: 1;
    width: 72%;
  }

  .mock-browser {
    background: #080F18;
    border: 1px solid rgba(30,159,232,0.18);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0,0,0,0.5);
  }

  .mock-browser__bar {
    background: #050A10;
    padding: 6px 8px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .mock-dot {
    display: inline-block;
    width: 5px; height: 5px;
    border-radius: 50%;
  }

  .mock-dot--r { background: #E24B4A; }
  .mock-dot--y { background: #EF9F27; }
  .mock-dot--g { background: #1D9E75; }

  .mock-browser__content {
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .mock-line {
    display: block;
    height: 4px;
    background: rgba(255,255,255,0.07);
    border-radius: 3px;
    width: 100%;
  }

  .mock-line--accent { width: 55%; }
  .mock-line--block  { height: 32px; margin: 3px 0; }

  /* Número decorativo */
  .pf-card__num {
    position: absolute;
    bottom: 10px; right: 14px;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: rgba(255,255,255,0.03);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  /* Overlay con CTAs */
  .pf-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5,10,15,0.96) 0%,
      rgba(5,10,15,0.65) 55%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.28s;
    display: flex;
    align-items: flex-end;
    z-index: 3;
  }

  .pf-card:hover .pf-card__overlay { opacity: 1; }

  .pf-card__overlay-content {
    padding: 18px;
    transform: translateY(4px);
    transition: transform 0.28s var(--ease-out);
    width: 100%;
  }

  .pf-card:hover .pf-card__overlay-content { transform: translateY(0); }

  .pf-card__cat {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 4px;
  }

  .pf-card__title {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: 3px;
    line-height: 1.25;
  }

  .pf-card__result {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .pf-card__btns {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
  }

  .pf-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
  }

  .pf-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  .pf-btn--primary {
    background: var(--color-blue);
    color: #fff;
  }

  .pf-btn--ghost {
    background: rgba(255,255,255,0.08);
    color: var(--color-text);
    border: 1px solid rgba(255,255,255,0.12);
  }

  .portfolio__cta { text-align: center; }

  /* ======================================================
     MODAL
  ====================================================== */
  .pf-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .pf-modal--open {
    pointer-events: all;
    opacity: 1;
  }

  .pf-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5,10,15,0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .pf-modal__panel {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 660px;
    max-height: 90vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateY(16px);
    transition: transform 0.38s var(--ease-out);
  }

  .pf-modal--open .pf-modal__panel { transform: translateY(0); }

  .pf-modal__close {
    position: absolute;
    top: 1rem; right: 1rem;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
    transition: background 0.2s, color 0.2s;
  }

  .pf-modal__close:hover {
    background: var(--color-surface-3);
    color: var(--color-text);
  }

  /* Visual area */
  .pf-modal__visual {
    height: 200px;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
