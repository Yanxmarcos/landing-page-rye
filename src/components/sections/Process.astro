---
import { processSteps } from '../../data/process';

// Iconos SVG por clave — sin dependencias externas
const icons: Record<string, string> = {
  clock:   `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 5v3.5l2 1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  globe:   `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 1.5C8 1.5 5.5 4 5.5 8s2.5 6.5 2.5 6.5M8 1.5C8 1.5 10.5 4 10.5 8S8 14.5 8 14.5M1.5 8h13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
  file:    `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 2h5.5L12 4.5V14H4V2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M9.5 2v3h2.5M6 7h4M6 9.5h4M6 12h2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
  palette: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2a6 6 0 100 12 3 3 0 000-6 3 3 0 010-6z" stroke="currentColor" stroke-width="1.3"/><circle cx="5.5" cy="6" r="1" fill="currentColor"/><circle cx="10.5" cy="6" r="1" fill="currentColor"/><circle cx="5.5" cy="10" r="1" fill="currentColor"/></svg>`,
  figma:   `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="5" height="5" rx="2" stroke="currentColor" stroke-width="1.3"/><rect x="2" y="9" width="5" height="5" rx="2" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="2" width="5" height="5" rx="2" stroke="currentColor" stroke-width="1.3"/><circle cx="11.5" cy="11.5" r="2.5" stroke="currentColor" stroke-width="1.3"/></svg>`,
  refresh: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 8a6 6 0 016-6 6 6 0 014.2 1.7L14 2M14 2v4h-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  zap:     `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M9 2L3 9h5l-1 5 6-7H8l1-5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>`,
  chart:   `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 13V8h3v5M7 13V5h3v8M12 13V2h2v11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  lock:    `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M5 7V5a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
  search:  `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
  chat:    `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 3h12v8H9l-3 2v-2H2V3z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>`,
  devices: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="5" width="8" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M9 7h4.5a1 1 0 011 1v3a1 1 0 01-1 1H9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M5 12v2M3.5 14h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
  rocket:  `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2s3 1 3 6l-3 3-3-3c0-5 3-6 3-6z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M5 8l-2 2 1 1M11 8l2 2-1 1M8 11v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  shield:  `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2l5 2v4c0 3-5 6-5 6S3 11 3 8V4l5-2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M6 8l1.5 1.5L10 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  key:     `<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="6" cy="7" r="3.5" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 9.5l5 5M11.5 11.5l1.5-1.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`,
};
---

<section class="process section" id="proceso">
  <div class="container">

    <!-- Header -->
    <div class="process__header">
      <span class="process__eyebrow">Cómo trabajamos</span>
      <h2 class="process__title">Un proceso claro,<br />sin sorpresas</h2>
      <p class="process__subtitle">
        Navega cada etapa — así funciona cada proyecto que hacemos.
      </p>
    </div>

    <!-- Stepper nav -->
    <div class="process__stepper" id="process-stepper" role="tablist" aria-label="Etapas del proceso">
      <!-- Línea base -->
      <span class="stepper__track" aria-hidden="true"></span>
      <!-- Línea de progreso -->
      <span class="stepper__progress" id="stepper-progress" aria-hidden="true"></span>

      {processSteps.map((step, i) => (
        <button
          class:list={['stepper__btn', i === 0 && 'stepper__btn--active']}
          data-step={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`process-panel-${i}`}
          id={`process-tab-${i}`}
        >
          <span class="stepper__dot">
            <span class="stepper__dot-num">{i + 1}</span>
            <span class="stepper__dot-check" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M1.5 5l2.5 2.5 4.5-4.5"
                      stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </span>
          <span class="stepper__label">{step.title.split(' ')[0]}</span>
        </button>
      ))}
    </div>

    <!-- Panels -->
    <div class="process__panels" id="process-panels">
      {processSteps.map((step, i) => (
        <div
          class:list={['process__panel', i === 0 && 'process__panel--active']}
          id={`process-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`process-tab-${i}`}
          data-panel={i}
        >
          <div class="panel__inner">

            <!-- Número decorativo de fondo -->
            <span class="panel__bg-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            <!-- Columna izquierda -->
            <div class="panel__left">
              <span class="panel__tag">
                <span class="panel__tag-dot" aria-hidden="true"></span>
                {step.tag}
              </span>
              <h3 class="panel__title">{step.title}</h3>
              <p class="panel__desc">{step.description}</p>

              <ul class="panel__deliverables" role="list">
                {step.deliverables.map(item => (
                  <li class="panel__deliverable">
                    <span class="panel__deliverable-icon" aria-hidden="true">
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                        <path d="M1 5l2.5 2.5 5.5-5.5"
                              stroke="#1E9FE8" stroke-width="1.5"
                              stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Columna derecha: métricas -->
            <div class="panel__right">
              {step.metrics.map(metric => (
                <div class="metric-card">
                  <span class="metric-card__icon"
                        set:html={icons[metric.icon] ?? icons.clock}>
                  </span>
                  <div class="metric-card__info">
                    <span class="metric-card__val">{metric.value}</span>
                    <span class="metric-card__lbl">{metric.label}</span>
                  </div>
                </div>
              ))}
            </div>

          </div>

          <!-- Navegación del panel -->
          <div class="panel__nav">
            {i > 0
              ? <button class="panel__nav-prev" data-goto={i - 1}>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.6"
                          stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {processSteps[i - 1].title.split(' ')[0]}
                </button>
              : <span></span>
            }

            <span class="panel__nav-counter">
              <strong>{i + 1}</strong> / {processSteps.length}
            </span>

            {i < processSteps.length - 1
              ? <button class="panel__nav-next" data-goto={i + 1}>
                  {step.nextLabel}
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.6"
                          stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              : <a href="#contacto" class="panel__nav-next panel__nav-cta">
                  Cotizar proyecto
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.6"
                          stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
            }
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const TOTAL = document.querySelectorAll('.stepper__btn').length;

  function goTo(idx: number) {
    if (idx < 0 || idx >= TOTAL) return;

    // Actualizar stepper buttons
    document.querySelectorAll<HTMLElement>('.stepper__btn').forEach((btn, i) => {
      btn.classList.remove('stepper__btn--active', 'stepper__btn--done');
      btn.setAttribute('aria-selected', 'false');
      if (i < idx)  btn.classList.add('stepper__btn--done');
      if (i === idx) {
        btn.classList.add('stepper__btn--active');
        btn.setAttribute('aria-selected', 'true');
      }
    });

    // Barra de progreso
    const pct = idx === 0 ? 0 : (idx / (TOTAL - 1)) * 100;
    const bar = document.getElementById('stepper-progress');
    if (bar) bar.style.width = pct + '%';

    // Paneles: fade out → swap → fade in
    const panels = document.querySelectorAll<HTMLElement>('.process__panel');
    const current = document.querySelector<HTMLElement>('.process__panel--active');

    if (current && current !== panels[idx]) {
      current.classList.add('process__panel--exit');
      setTimeout(() => {
        current.classList.remove('process__panel--active', 'process__panel--exit');
        panels[idx].classList.add('process__panel--active');
      }, 220);
    } else if (!current) {
      panels[idx].classList.add('process__panel--active');
    }
  }

  // Click en stepper buttons
  document.querySelectorAll<HTMLButtonElement>('.stepper__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      goTo(parseInt(btn.dataset.step ?? '0'));
    });
  });

  // Click en botones de navegación dentro del panel
  document.querySelectorAll<HTMLButtonElement>('.panel__nav-prev, .panel__nav-next').forEach(btn => {
    if (btn.tagName === 'BUTTON') {
      btn.addEventListener('click', () => {
        goTo(parseInt(btn.dataset.goto ?? '0'));
      });
    }
  });

  // Teclado: flechas izquierda/derecha
  document.getElementById('process-stepper')?.addEventListener('keydown', (e: KeyboardEvent) => {
    const active = document.querySelector<HTMLElement>('.stepper__btn--active');
    const idx = parseInt(active?.dataset.step ?? '0');
    if (e.key === 'ArrowRight') { e.preventDefault(); goTo(idx + 1); }
    if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(idx - 1); }
  });
</script>

<style>
  .process {
    background: var(--color-bg);
  }

  /* --- Header ------------------------------------------- */
  .process__header {
    max-width: 560px;
    margin-bottom: 3.5rem;
  }

  .process__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
  }

  .process__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .process__subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ======================================================
     STEPPER NAV
  ====================================================== */
  .process__stepper {
    display: flex;
    align-items: flex-start;
    position: relative;
    margin-bottom: 2.5rem;
  }

  /* Línea base */
  .stepper__track {
    position: absolute;
    top: 22px; left: 22px; right: 22px;
    height: 1.5px;
    background: var(--color-border);
    border-radius: 2px;
  }

  /* Línea de progreso */
  .stepper__progress {
    position: absolute;
    top: 22px; left: 22px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--color-blue), var(--color-violet));
    border-radius: 2px;
    width: 0%;
    transition: width 0.55s var(--ease-out);
    z-index: 1;
  }

  /* Botón de cada step */
  .stepper__btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 4px;
    position: relative;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }

  /* Círculo numerado */
  .stepper__dot {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition:
      background 0.3s var(--ease-out),
      border-color 0.3s,
      box-shadow 0.3s,
      transform 0.3s var(--ease-out);
  }

  .stepper__dot-num {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-text-muted);
    transition: color 0.25s, opacity 0.2s;
  }

  /* Check (oculto por defecto) */
  .stepper__dot-check {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-blue);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .stepper__label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.3;
    transition: color 0.25s;
    white-space: nowrap;
  }

  /* Estados */
  .stepper__btn:hover .stepper__dot {
    border-color: rgba(30,159,232,0.4);
    transform: translateY(-3px);
  }

  .stepper__btn:hover .stepper__dot-num  { color: var(--color-text); }
  .stepper__btn:hover .stepper__label    { color: var(--color-text); }

  /* Activo */
  .stepper__btn--active .stepper__dot {
    background: var(--color-blue);
    border-color: var(--color-blue);
    box-shadow: 0 0 0 6px rgba(30,159,232,0.13);
    transform: translateY(-3px);
  }

  .stepper__btn--active .stepper__dot-num  { color: #fff; }
  .stepper__btn--active .stepper__label    { color: var(--color-blue); font-weight: 700; }

  /* Completado */
  .stepper__btn--done .stepper__dot {
    background: rgba(30,159,232,0.12);
    border-color: var(--color-blue);
  }

  .stepper__btn--done .stepper__dot-num   { opacity: 0; }
  .stepper__btn--done .stepper__dot-check { opacity: 1; }
  .stepper__btn--done .stepper__label     { color: var(--color-text); }

  /* ======================================================
     PANELS
  ====================================================== */
  .process__panels {
    position: relative;
  }

  .process__panel {
    display: none;
    opacity: 0;
    transform: translateY(12px);
  }

  .process__panel--active {
    display: block;
    animation: panel-in 0.4s var(--ease-out) forwards;
  }

  .process__panel--exit {
    animation: panel-out 0.22s ease forwards;
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes panel-out {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(-8px); }
  }

  /* Panel inner */
  .panel__inner {
    background: var(--color-surface);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    position: relative;
    overflow: hidden;
  }

  /* Glow decorativo */
  .panel__inner::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(30,159,232,0.07), transparent 70%);
    pointer-events: none;
  }

  /* Número gigante de fondo */
  .panel__bg-num {
    position: absolute;
    top: 1rem; right: 2rem;
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: rgba(30,159,232,0.05);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* Tag */
  .panel__tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-blue);
    background: rgba(30,159,232,0.08);
    border: 1px solid rgba(30,159,232,0.2);
    border-radius: var(--radius-full);
    padding: 4px 12px;
    margin-bottom: 1rem;
  }

  .panel__tag-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--color-blue);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.35; transform: scale(0.6); }
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .panel__desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1.5rem;
    max-width: 44ch;
  }

  /* Deliverables */
  .panel__deliverables {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .panel__deliverable {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .panel__deliverable-icon {
    width: 20px; height: 20px;
    border-radius: 50%;
    background: rgba(30,159,232,0.1);
    border: 1px solid rgba(30,159,232,0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Métricas */
  .panel__right {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .metric-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.125rem;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: border-color 0.22s, background 0.22s;
  }

  .metric-card:hover {
    border-color: var(--color-border-hover);
    background: var(--color-surface-3);
  }

  .metric-card__icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    background: rgba(30,159,232,0.1);
    border: 1px solid rgba(30,159,232,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-blue);
  }

  .metric-card__val {
    display: block;
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .metric-card__lbl {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 3px;
  }

  /* Navegación del panel */
  .panel__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
    gap: 1rem;
  }

  .panel__nav-counter {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .panel__nav-counter strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .panel__nav-prev {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 8px 16px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .panel__nav-prev:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    background: var(--color-surface-2);
  }

  .panel__nav-next {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-blue);
    border: none;
    border-radius: var(--radius-full);
    padding: 9px 22px;
    cursor: pointer;
