---
import { reviews, reviewStats } from '../../data/reviews';
---

<section class="reviews section" id="resenas">
  <div class="container">

    <!-- Header -->
    <div class="reviews__header">
      <span class="reviews__eyebrow">Lo que dicen nuestros clientes</span>
      <h2 class="reviews__title">
        Resultados que hablan<br />por sí solos
      </h2>
      <p class="reviews__subtitle">
        Más de {reviewStats.totalClients} negocios en Perú confían en RYE WEB
        para su presencia digital.
      </p>
    </div>

    <!-- Stats strip -->
    <div class="reviews__stats">
      <div class="reviews__stat">
        <span class="reviews__stat-val">
          {reviewStats.totalClients}
        </span>
        <span class="reviews__stat-lbl">Clientes satisfechos</span>
      </div>
      <span class="reviews__stat-divider" aria-hidden="true"></span>
      <div class="reviews__stat">
        <span class="reviews__stat-val">
          {reviewStats.recommend}
        </span>
        <span class="reviews__stat-lbl">Recomendarían RYE WEB</span>
      </div>
      <span class="reviews__stat-divider" aria-hidden="true"></span>
      <div class="reviews__stat">
        <span class="reviews__stat-val">
          {reviewStats.avgConversion}
        </span>
        <span class="reviews__stat-lbl">Más conversiones promedio</span>
      </div>
    </div>

    <!-- Grid de reseñas -->
    <div class="reviews__grid">
      {reviews.map(review => (
        <article
          class:list={['review-card', review.featured && 'review-card--featured']}
          aria-label={`Reseña de ${review.name}`}
        >
          <!-- Comillas decorativas -->
          <span class="review-card__quote" aria-hidden="true">"</span>

          <!-- Estrellas -->
          <div class="review-card__stars" aria-label={`${review.rating} estrellas`}>
            {Array(review.rating).fill(null).map(() => (
              <svg width="15" height="15" viewBox="0 0 14 14" fill="#F5C518" aria-hidden="true">
                <path d="M7 1l1.6 3.3 3.6.5-2.6 2.5.6 3.6L7 9.3l-3.2 1.6.6-3.6L1.8 4.8l3.6-.5z"/>
              </svg>
            ))}
          </div>

          <!-- Texto de la reseña -->
          <blockquote class="review-card__text">
            "{review.text}"
          </blockquote>

          <!-- Pill de resultado -->
          <div class="review-card__pill">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M1 5l2.5 2.5 5.5-5.5"
                    stroke="#1E9FE8" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {review.resultPill}
          </div>

          <!-- Divisor -->
          <span class="review-card__divider" aria-hidden="true"></span>

          <!-- Autor -->
          <footer class="review-card__author">
            <div
              class="review-card__avatar"
              style={`background:${review.avatarGrad}`}
              aria-hidden="true"
            >
              {review.initials}
            </div>
            <div class="review-card__author-info">
              <span class="review-card__name">{review.name}</span>
              <span class="review-card__role">
                {review.role} · {review.company}, {review.location}
              </span>
              <span class="review-card__verified">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <circle cx="5" cy="5" r="4.5" fill="#1D9E75" fill-opacity="0.2"
                          stroke="#1D9E75" stroke-width="0.8"/>
                  <path d="M2.5 5l1.8 1.8 3.2-3.2"
                        stroke="#1D9E75" stroke-width="1.2"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Cliente verificado
              </span>
            </div>
          </footer>

        </article>
      ))}
    </div>

    <!-- CTA final -->
    <div class="reviews__cta">
      <p class="reviews__cta-text">
        ¿Quieres resultados como estos para tu negocio?
      </p>
      <a href="#contacto" class="reviews__cta-btn">
        Cotizar mi proyecto
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M7.5 3l4.5 4-4.5 4"
                stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .reviews {
    background: var(--color-bg);
  }

  /* --- Header ------------------------------------------- */
  .reviews__header {
    max-width: 580px;
    margin-bottom: 2.5rem;
  }

  .reviews__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
  }

  .reviews__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .reviews__subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* --- Stats strip -------------------------------------- */
  .reviews__stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.25rem 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .reviews__stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .reviews__stat-val {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1;
  }

  .reviews__stat-lbl {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .reviews__stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  /* --- Grid --------------------------------------------- */
  .reviews__grid {
    display: grid;
    grid-template-columns: minmax(0, 40rem);
    gap: 1.125rem;
    margin-bottom: 3rem;
  }

  /* ======================================================
     REVIEW CARD
  ====================================================== */
  .review-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.625rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.28s var(--ease-out), transform 0.28s var(--ease-out);
    display: flex;
    flex-direction: column;
  }

  .review-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  /* Card destacada */
  .review-card--featured {
    border-color: rgba(30,159,232,0.28);
    background: linear-gradient(
      135deg,
      rgba(30,159,232,0.05) 0%,
      var(--color-surface) 60%
    );
  }

  .review-card--featured::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-blue), var(--color-violet));
  }

  /* Comillas decorativas */
  .review-card__quote {
    position: absolute;
    top: -8px; right: 16px;
    font-size: 86px;
    font-family: Georgia, 'Times New Roman', serif;
    color: rgba(30,159,232,0.07);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    font-style: normal;
  }

  /* Estrellas */
  .review-card__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 1rem;
  }

  /* Texto */
  .review-card__text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    font-style: italic;
    margin-bottom: 1rem;
    flex: 1;
    quotes: none;
  }

  /* Pill de resultado */
  .review-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-blue);
    background: rgba(30,159,232,0.08);
    border: 1px solid rgba(30,159,232,0.2);
    border-radius: var(--radius-full);
    padding: 4px 11px;
    margin-bottom: 1rem;
    width: fit-content;
  }

  /* Divisor */
  .review-card__divider {
    display: block;
    height: 1px;
    background: var(--color-border);
    margin-bottom: 1rem;
  }

  /* Autor */
  .review-card__author {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .review-card__avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
    border: 2px solid rgba(255,255,255,0.1);
    letter-spacing: 0.02em;
  }

  .review-card__author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .review-card__name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .review-card__role {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 600;
    color: #1D9E75;
    margin-top: 2px;
  }

  /* --- CTA final ---------------------------------------- */
  .reviews__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .reviews__cta-text {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .reviews__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-blue);
    color: #fff;
    border-radius: var(--radius-full);
    padding: 0.875rem 2.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
  }

  .reviews__cta-btn:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  /* --- Responsivo --------------------------------------- */
  @media (max-width: 960px) {
    .reviews__stats {
      gap: 1.25rem;
    }

    .reviews__stat-divider { display: none; }
  }

  @media (max-width: 580px) {
    .reviews__stats {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
