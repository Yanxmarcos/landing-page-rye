---
const values = [
  'Estrategia antes que diseño',
  'Comunicación clara en cada etapa',
  'Código limpio y mantenible',
  'Resultados, no promesas',
];
---

<section class="about section" id="nosotros">
  <div class="container">
    <div class="about__inner">

      <!-- Izquierda: visual / stats card -->
      <div class="about__visual" aria-hidden="true">
        <div class="about__card">
          <div class="about__card-header">
            <span class="about__card-dot about__card-dot--blue"></span>
            <span class="about__card-dot about__card-dot--muted"></span>
            <span class="about__card-dot about__card-dot--muted"></span>
            <span class="about__card-label">Rendimiento del sitio</span>
          </div>
          <div class="about__metrics">
            <div class="about__metric">
              <span class="about__metric-bar">
                <span class="about__metric-fill" style="width:98%"></span>
              </span>
              <span class="about__metric-label">Performance</span>
              <span class="about__metric-val">98</span>
            </div>
            <div class="about__metric">
              <span class="about__metric-bar">
                <span class="about__metric-fill" style="width:100%"></span>
              </span>
              <span class="about__metric-label">Accessibility</span>
              <span class="about__metric-val">100</span>
            </div>
            <div class="about__metric">
              <span class="about__metric-bar">
                <span class="about__metric-fill" style="width:100%"></span>
              </span>
              <span class="about__metric-label">Best Practices</span>
              <span class="about__metric-val">100</span>
            </div>
            <div class="about__metric">
              <span class="about__metric-bar">
                <span class="about__metric-fill" style="width:95%"></span>
              </span>
              <span class="about__metric-label">SEO</span>
              <span class="about__metric-val">95</span>
            </div>
          </div>
          <div class="about__card-footer">
            <span class="about__card-badge">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 6l3 3 5-5" stroke="#1D9E75" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Lighthouse Score
            </span>
          </div>
        </div>
      </div>

      <!-- Derecha: copy -->
      <div class="about__content">
        <span class="about__eyebrow">Quiénes somos</span>
        <h2 class="about__title">
          Construimos tu presencia<br />digital con estrategia
        </h2>
        <p class="about__text">
          En RYE WEB no solo escribimos código, entendemos tu negocio, tu
          público y tus metas. Cada proyecto parte de un diagnóstico real
          para entregar resultados medibles.
        </p>
        <p class="about__text">
          Somos un equipo especializado en desarrollo web moderno, con foco
          en rendimiento, SEO y experiencia de usuario. Trabajamos con
          emprendedores, restaurantes, clínicas y empresas que quieren crecer
          en digital sin depender de soluciones genéricas.
        </p>

        <ul class="about__values" role="list">
          {values.map(value => (
            <li class="about__value">
              <span class="about__value-dot" aria-hidden="true"></span>
              {value}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-bg);
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* --- Tarjeta visual izquierda ------------------------- */
  .about__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .about__card-header {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }

  .about__card-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  .about__card-dot--blue  { background: var(--color-blue); }
  .about__card-dot--muted { background: rgba(122,143,166,0.3); }

  .about__card-label {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-left: 4px;
  }

  .about__metrics {
    padding: 1.5rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about__metric {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 4px 8px;
    align-items: center;
  }

  .about__metric-bar {
    grid-column: 1 / -1;
    display: block;
    height: 5px;
    background: rgba(255,255,255,0.06);
    border-radius: 100px;
    overflow: hidden;
  }

  .about__metric-fill {
    display: block;
    height: 100%;
    background: var(--color-blue);
    border-radius: 100px;
    transform-origin: left;
    animation: bar-grow 1.2s var(--ease-out) both;
  }

  @keyframes bar-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .about__metric-label {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .about__metric-val {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-blue);
  }

  .about__card-footer {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about__card-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #1D9E75;
    background: rgba(29,158,117,0.1);
    border: 1px solid rgba(29,158,117,0.2);
    border-radius: var(--radius-full);
    padding: 4px 12px;
  }

  /* --- Contenido derecho -------------------------------- */
  .about__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
  }

  .about__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .about__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.78;
    margin-bottom: 1rem;
  }

  .about__values {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .about__value {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .about__value-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-blue);
    flex-shrink: 0;
  }

  /* --- Responsive --------------------------------------- */
  @media (max-width: 860px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about__visual { order: -1; }
  }
</style>
