---
import { services } from '../../data/services';
import { cn } from '../../utils/cn';
---

<section class="services section" id="servicios">
  <div class="container">

    <div class="services__header">
      <span class="services__eyebrow">Lo que hacemos</span>
      <h2 class="services__title">
        Servicios que impulsan<br />tu crecimiento
      </h2>
      <p class="services__subtitle">
        Haz click en cualquier servicio para ver beneficios, tiempos y precios.
      </p>
    </div>

    <div class="services__grid">
      {services.map((service, i) => (
        <article class={cn("svc-card", `reveal reveal-delay-${i + 1}`)}>
          <span class="svc-card__glow" aria-hidden="true"></span>

          <div class="svc-card__content">
            <span class="svc-card__tag">{service.tag}</span>
            <span class="svc-card__line" aria-hidden="true"></span>
            <h3 class="svc-card__title">{service.title}</h3>
            <p class="svc-card__desc">{service.description}</p>
          </div>

          <div class="svc-card__actions">
            <a href={`/servicios/${service.slug}`} class="btn btn--sm btn--ghost">
              Ver más detalles
            </a>
            <a href="/#contacto" class="btn btn--sm btn--primary">
              Cotizar
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-surface);
  }

  /* --- Header ------------------------------------------- */
  .services__header {
    max-width: 600px;
    margin-bottom: 3.5rem;
  }

  .services__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
  }

  .services__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .services__subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* --- Grid --------------------------------------------- */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.125rem;
  }

  /* ======================================================
     CARD
  ====================================================== */
  .svc-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    transition:
      border-color  0.28s var(--ease-out),
      box-shadow    0.28s var(--ease-out);
  }

  /* Borde superior azul en hover */
  .svc-card:hover::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-blue), var(--color-violet));
  }

  .svc-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  /* --- Glow interior ------------------------------------ */
  .svc-card__glow {
    position: absolute;
    top: 0; left: 0;
    background: radial-gradient(ellipse 80% 60% at 15% 0%, rgba(30,159,232,0.07), transparent);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .svc-card:hover .svc-card__glow { opacity: 1; }

  /* --- Contenido ---------------------------------------- */
  .svc-card__content {
    position: relative;
    flex-grow: 1; /* Empuja los botones hacia abajo */
  }

  .svc-card__tag {
    display: inline-block;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue);
    background: rgba(30,159,232,0.1);
    border-radius: var(--radius-full);
    padding: 3px 10px;
    margin-bottom: 0.875rem;
  }

  .svc-card__line {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-blue);
    border-radius: 2px;
    margin-bottom: 0.75rem;
    transition: width 0.35s var(--ease-out);
  }

  .svc-card:hover .svc-card__line { width: 44px; }

  .svc-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .svc-card__desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  /* --- Acciones / Botones ------------------------------- */
  .svc-card__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    position: relative;
    z-index: 2; /* Asegura que los botones sean clickeables por encima de efectos */
  }

  /* --- Responsive --------------------------------------- */
  @media (max-width: 960px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .services__grid { grid-template-columns: 1fr; }
  }
</style>