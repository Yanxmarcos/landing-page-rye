---
import ContactForm from '../ui/ContactForm.astro';
import { contactConfig } from '../../data/contact';

const { whatsapp, email, socials } = contactConfig;

const socialIcons: Record<string, string> = {
  tiktok: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>`,
  facebook: `<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  instagram: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`,
};
---

<section class="contact section" id="contacto">
  <div class="container">
    <div class="contact__inner">

      <!-- INFO izquierda -->
      <div class="contact__info">
        <span class="contact__eyebrow">Hablemos</span>
        <h2 class="contact__title">
          ¿Listo para empezar<br />tu proyecto?
        </h2>
        <p class="contact__subtitle">
          Sin compromiso. Te respondemos en menos de 24 horas.
        </p>

        <!-- Canales -->
        <div class="contact__channels">
          <a href={whatsapp.url} target="_blank" rel="noopener noreferrer"
             class="contact__channel" aria-label="Contactar por WhatsApp">
            <span class="contact__ch-icon contact__ch-icon--wa">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </span>
            <span class="contact__ch-info">
              <span class="contact__ch-name">WhatsApp</span>
              <span class="contact__ch-detail">{whatsapp.display}</span>
            </span>
          </a>

          <a href={email.url} class="contact__channel"
             aria-label={`Enviar correo a ${email.address}`}>
            <span class="contact__ch-icon contact__ch-icon--mail">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="3"/>
                <path d="M2 7l10 7 10-7"/>
              </svg>
            </span>
            <span class="contact__ch-info">
              <span class="contact__ch-name">Correo electrónico</span>
              <span class="contact__ch-detail">{email.address}</span>
            </span>
          </a>
        </div>

        <!-- Redes -->
        <div class="contact__socials">
          <span class="contact__socials-label">Síguenos en</span>
          <div class="contact__socials-links">
            {socials.map(social => (
              <a href={social.url} target="_blank" rel="noopener noreferrer"
                 class="contact__social" aria-label={social.label}
                 set:html={socialIcons[social.id] ?? ''} />
            ))}
          </div>
        </div>

        <!-- Horario -->
        <div class="contact__schedule">
          <span class="contact__schedule-dot" aria-hidden="true"></span>
          <span class="contact__schedule-text">
            Lunes a Sábado · 24/7 (Perú)
          </span>
        </div>
      </div>

      <!-- FORMULARIO derecha -->
      <div class="contact__form-wrap">
        <div class="contact__form-card">
          <div class="contact__form-header">
            <span class="contact__form-title">Cuéntanos tu proyecto</span>
            <span class="contact__form-badge">Respondemos en 24h</span>
          </div>
          <div class="contact__form-body">
            <ContactForm />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  /* =====================================================
     GRID — este es el fix principal
     Usamos una sola columna por defecto (mobile-first)
     y activamos el grid de 2 columnas SOLO cuando
     hay espacio real para las dos (≥ 1100px)
  ===================================================== */
  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Dos columnas solo en pantallas anchas */
  @media (min-width: 1400px) {
    .contact__inner {
      display: grid;
      grid-template-columns: 380px 2fr;
      gap: 4rem;
      align-items: start;
    }
  }

  /* Entre 860px y 1099px: una columna, el form no se superpone */
  @media (min-width: 860px) and (max-width: 1099px) {
    .contact__inner {
      max-width: 600px;
    }
  }

  /* --- Eyebrow + heading -------------------------------- */
  .contact__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-blue);
    margin-bottom: 0.875rem;
  }

  .contact__title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 0.875rem;
  }

  .contact__subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 1.75rem;
  }

  /* --- Canales ------------------------------------------ */
  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 1.75rem;
  }

  .contact__channel {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.875rem 1rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.22s, background 0.22s, transform 0.22s;
  }

  .contact__channel:hover {
    border-color: var(--color-border-hover);
    background: rgba(30,159,232,0.04);
    transform: translateX(4px);
  }

  .contact__ch-icon {
    width: 42px; height: 42px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact__ch-icon--wa   { background: rgba(37,211,102,0.12); color: #25D366; }
  .contact__ch-icon--mail { background: rgba(30,159,232,0.1);  color: var(--color-blue); }

  .contact__ch-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .contact__ch-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .contact__ch-detail {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* --- Redes -------------------------------------------- */
  .contact__socials {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.375rem;
    flex-wrap: wrap;
  }

  .contact__socials-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .contact__socials-links { display: flex; gap: 8px; }

  .contact__social {
    width: 37px; height: 37px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .contact__social:hover {
    color: var(--color-blue);
    border-color: var(--color-border-hover);
    background: rgba(30,159,232,0.07);
    transform: translateY(-3px);
  }

  /* --- Horario ------------------------------------------ */
  .contact__schedule {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact__schedule-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #1D9E75;
    flex-shrink: 0;
    animation: pulse-g 2s ease-in-out infinite;
  }

  @keyframes pulse-g {
    0%, 100% { box-shadow: 0 0 0 0 rgba(29,158,117,0.4); }
    50%       { box-shadow: 0 0 0 5px rgba(29,158,117,0); }
  }

  .contact__schedule-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* --- Tarjeta del formulario --------------------------- */
  .contact__form-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .contact__form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    background: var(--color-surface-3);
    border-bottom: 1px solid var(--color-border);
    gap: 8px;
    flex-wrap: wrap;
  }

  .contact__form-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .contact__form-badge {
    font-size: 0.65rem;
    font-weight: 700;
    color: #1D9E75;
    background: rgba(29,158,117,0.1);
    border: 1px solid rgba(29,158,117,0.22);
    border-radius: var(--radius-full);
    padding: 3px 10px;
    white-space: nowrap;
  }

  .contact__form-body {
    padding: 1.375rem;
  }
</style>